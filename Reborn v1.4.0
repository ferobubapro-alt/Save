CmdInput.TextSize = 11
CmdInput.TextXAlignment = Enum.TextXAlignment.Left
CmdInput.ClearTextOnFocus = false
CmdInput.ZIndex = 60 
CmdInput.Active = true
CmdInput.Parent = CmdFrame

local CmdExec = Instance.new("TextButton")
CmdExec.Size = UDim2.new(0, 80, 0, 25)
CmdExec.Position = UDim2.new(1, -85, 0, 5)
CmdExec.BackgroundColor3 = Color3.fromRGB(92, 36, 211)
CmdExec.Text = "▶ Execute"
CmdExec.Font = Enum.Font.GothamBold
CmdExec.TextColor3 = Color3.fromRGB(255, 255, 255)
