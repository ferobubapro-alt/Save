-- GERÇEKTEN ÇALIŞAN HIZLI BUTON (QC) SCRİPTLERİ
-- ===============================================
CreateQCToggle("God Mode", function(state)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        if state then
            char.Humanoid.MaxHealth = math.huge
            char.Humanoid.Health = math.huge
        else
            char.Humanoid.MaxHealth = 100
            char.Humanoid.Health = 100
        end
    end
end)

local InfJumpConn
CreateQCToggle("Infinite Jump", function(state)
    if state then
        InfJumpConn = UserInputService.JumpRequest:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    else
        if InfJumpConn then InfJumpConn:Disconnect() InfJumpConn = nil end
    end
end)

CreateQCToggle("Speed Hack", function(state)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = state and 50 or 16
    end
end)

local QCNoclip
CreateQCToggle("Noclip", function(state)
    if state then
        QCNoclip = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, p in pairs(LocalPlayer.Character:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                end
            end
        end)
    else
        if QCNoclip then QCNoclip:Disconnect() QCNoclip = nil end
    end
end)

-- KLASİK ROBLOX UÇMA SCRİPTİ (Kameraya göre yönlenen Fly)
local QCFly, FlyGyro, FlyVel
CreateQCToggle("Fly", function(state)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if state and hrp then
        char.Humanoid.PlatformStand = true
        FlyGyro = Instance.new("BodyGyro", hrp)
        FlyGyro.P = 9e4
        FlyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        FlyGyro.CFrame = hrp.CFrame
        
        FlyVel = Instance.new("BodyVelocity", hrp)
        FlyVel.Velocity = Vector3.new(0, 0, 0)
        FlyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        
        local cam = Workspace.CurrentCamera
        local flySpeed = 50
        
        QCFly = RunService.RenderStepped:Connect(function()
            if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") then return end
            
            local ctrl = {f = 0, b = 0, l = 0, r = 0}
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then ctrl.f = 1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then ctrl.b = -1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then ctrl.l = -1 end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then ctrl.r = 1 end
            
            FlyGyro.CFrame = cam.CFrame
            local moveDir = (cam.CFrame.LookVector * (ctrl.f + ctrl.b)) + (cam.CFrame.RightVector * (ctrl.l + ctrl.r))
            
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                moveDir = moveDir + Vector3.new(0, 1, 0)
            elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                moveDir = moveDir + Vector3.new(0, -1, 0)
            end
            
            FlyVel.Velocity = moveDir * flySpeed
        end)
    else
        if QCFly then QCFly:Disconnect() QCFly = nil end
        if FlyGyro then FlyGyro:Destroy() FlyGyro = nil end
        if FlyVel then FlyVel:Destroy() FlyVel = nil end
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
        end
    end
end)

-- MOR-KOYU MOR WAVE GRADIENT ESP (Klasik Highlight ESP)
local QCESPConn
local QCHighlightFolder = Instance.new("Folder")
QCHighlightFolder.Name = "QCWavyESP"
pcall(function() QCHighlightFolder.Parent = CoreGui end)

CreateQCToggle("ESP", function(state)
    if state then
        QCESPConn = RunService.RenderStepped:Connect(function()
            -- Renklerin Koyu Mordan -> Açık Mora dalgalanma formülü (Sine wave)
            local timeCalc = tick() * 2
            local r = math.clamp(math.sin(timeCalc) * 40 + 110, 70, 150) / 255 
            local g = math.clamp(math.sin(timeCalc) * 10 + 20, 10, 30) / 255   
            local b = math.clamp(math.sin(timeCalc) * 30 + 200, 170, 230) / 255 
            local waveColor = Color3.new(r, g, b)

            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hl = QCHighlightFolder:FindFirstChild(p.Name)
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = p.Name
                        hl.Adornee = p.Character
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.OutlineTransparency = 0.5
                        hl.FillTransparency = 0.35
                        hl.Parent = QCHighlightFolder
                    end
                    hl.Adornee = p.Character
                    hl.FillColor = waveColor -- Renk her saniye dalgalanarak değişir
                end
            end
        end)
    else
        if QCESPConn then QCESPConn:Disconnect() QCESPConn = nil end
        for _, v in pairs(QCHighlightFolder:GetChildren()) do v:Destroy() end
    end
end)

