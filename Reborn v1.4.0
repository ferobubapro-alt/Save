    ActionTxt.TextColor3 = Color3.fromRGB(255, 255, 255)
    ActionTxt.TextSize = 10
    ActionTxt.ZIndex = 6
    ActionTxt.Parent = ActionBtnFrame

    ClickArea.MouseButton1Click:Connect(function()
        if UserTierValue < 0 then Notify("Önce Key giriniz!"); return end
        if UserTierValue < minTier then Notify("Bu özellik " .. (minTier == 1 and "LITE" or "PRO") .. " gerektirir!"); return end

        TweenService:Create(ActionBtnFrame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(138, 43, 226)}):Play()
        task.wait(0.1)
        TweenService:Create(ActionBtnFrame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(45, 45, 50)}):Play()
        pcall(function() callback(ActionTxt) end)
    end)
      table.insert(FeatureElements, {UI = RowFrame, Tier = minTier}) -- YENİ EKLENDİ
end
-- ==========================================
-- ÖZELLİKLER VE SEKMELER
-- ==========================================
local Toggles = {AutoCoin = false, AutoGun = false, AutoKill = false, AntiAFK = false, SafeMode = false, PlayerESP = false, MurdererESP = false, SheriffESP = false, ShootMurderer = false}

-- === FARM SEKMESİ ===
local FarmCard = CreateCategoryCard(FarmTab, "Otomatik Kasılma (Farm)")

CreateToggle(FarmCard, "Akıllı Altın Topla", "En yakındakine uçar, buga girmez.", 1, function(state)
    Toggles.AutoCoin = state

    if not state then
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.Anchored = false
        end
    end

    task.spawn(function()
        while Toggles.AutoCoin do
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local hrp = char.HumanoidRootPart
                local targetCoin = nil
                local shortestDistance = math.huge

                -- En yakın coini hesaplayan döngü
                for _, v in pairs(Workspace:GetDescendants()) do
                    if v.Name == "Coin_Server" and v:IsA("BasePart") then
                        local distance = (hrp.Position - v.Position).Magnitude
                        if distance < shortestDistance then
                            shortestDistance = distance
                            targetCoin = v
                        end
                    end
                end

                if targetCoin then
                    local dist = (hrp.Position - targetCoin.Position).Magnitude
                    local timeToTravel = dist / 30 

                    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
                    local targetPos = targetCoin.CFrame * CFrame.new(0, 1.5, 0) 
                    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetPos})

                    hrp.Anchored = true
                    tween:Play()

                    while Toggles.AutoCoin and targetCoin.Parent and char.Humanoid.Health > 0 and tween.PlaybackState == Enum.PlaybackState.Playing do
                        task.wait(0.05)
                        if targetCoin and targetCoin.Parent then
                            if firetouchinterest then
                                firetouchinterest(hrp, targetCoin, 0)
                                firetouchinterest(hrp, targetCoin, 1)
                            end
                        else
                            tween:Cancel()
                            break
                        end
                    end

                    if tween then tween:Cancel() end
                    hrp.Anchored = false
                else
                    task.wait(0.5)
                end
            else
                task.wait(1)
            end
            task.wait(0.1)
        end
    end)
end)
CreateToggle(FarmCard, "Akıllı Silah Topla", "Silaha ışınlanıp eski yerine döner.", 0, function(state)
Toggles.AutoGun = state
while Toggles.AutoGun and task.wait(0.5) do
pcall(function()
local char = LocalPlayer.Character
if char and char:FindFirstChild("HumanoidRootPart") then
local hrp = char.HumanoidRootPart
for _, v in pairs(Workspace:GetDescendants()) do
if v.Name == "GunDrop" and v:IsA("BasePart") then
local originalCFrame = hrp.CFrame
hrp.CFrame = v.CFrame
task.wait(0.2)
hrp.CFrame = originalCFrame
task.wait(1) 
end
end
end
end)
end
end)

-- === SAVAŞ SEKMESİ ===
local CombatCard = CreateCategoryCard(CombatTab, "Saldırı ve Savunma")
local savedPositions = {}

CreateToggle(CombatCard, "Otomatik Katlet", "Herkesi önüne çeker ve katleder.", 2, function(state)
Toggles.AutoKill = state
if state then
savedPositions = {}
for _, plr in pairs(Players:GetPlayers()) do
if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
savedPositions[plr] = plr.Character.HumanoidRootPart.CFrame
end
end
Notify("Herkes önüne getiriliyor...")

task.spawn(function()
while Toggles.AutoKill do
local char = LocalPlayer.Character
local knife = LocalPlayer.Backpack:FindFirstChild("Knife") or (char and char:FindFirstChild("Knife"))

if char and char:FindFirstChild("HumanoidRootPart") then
local myHrp = char.HumanoidRootPart
if knife then
if knife.Parent ~= char then knife.Parent = char end
knife:Activate()
end

for _, plr in pairs(Players:GetPlayers()) do
if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
local targetHrp = plr.Character.HumanoidRootPart
local hum = plr.Character:FindFirstChild("Humanoid")
if hum and hum.Health > 0 then
targetHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, -3)
end
end
end
end
task.wait(0.05)
end
end)
else
for plr, oldCFrame in pairs(savedPositions) do
if plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
plr.Character.HumanoidRootPart.CFrame = oldCFrame
end
end
savedPositions = {}
Notify("Katliam durduruldu, oyuncular geri bırakıldı.")
end
end)
local AimbotConnection
local AimbotSmoothness = 0.6 -- Pürüzsüz ama hedeften tam kopmayan, merkeze sabitleyen değer

CreateToggle(CombatCard, "Katili Vur (Aimbot)", "Duvar arkasından bile katile pürüzsüz kilitlenir.", 2, function(state)
    Toggles.ShootMurderer = state
    local cam = Workspace.CurrentCamera

    if state then
        Notify("Aimbot Aktif: Katil duvar arkasında olsa bile hedefleniyor.")
        
        AimbotConnection = RunService.RenderStepped:Connect(function()
            if not Toggles.ShootMurderer then return end
            
            local murderer = nil
            
            -- Katili Bul (Envanterinde veya karakterinde Knife olan kişi)
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and (plr.Backpack:FindFirstChild("Knife") or plr.Character:FindFirstChild("Knife")) then
                    local hum = plr.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        murderer = plr
                        break
                    end
                end
            end

            -- Eğer katil bulunduysa, ekranda/duvarda olmasına bakmaksızın doğrudan kilitlen
            if murderer and murderer.Character and murderer.Character:FindFirstChild("Head") then
                local targetPart = murderer.Character.Head
                
                -- Pürüzsüz Kamera Takibi (Katil hep merkezde kalır)
                local targetCFrame = CFrame.lookAt(cam.CFrame.Position, targetPart.Position)
                cam.CFrame = cam.CFrame:Lerp(targetCFrame, AimbotSmoothness)
                
                -- Kilitlendiği an Crosshair'i aç
                if not CrosshairContainer.Visible then
                    CrosshairContainer.Visible = true
                    OuterRing.ImageTransparency = 1
                    TweenService:Create(OuterRing, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        ImageTransparency = 0
                    }):Play()
                end
            else
                -- Hedef ölürse veya katil yoksa crosshair'i kapat
                if CrosshairContainer.Visible then
                    CrosshairContainer.Visible = false
                end
            end
        end)
    else
        if AimbotConnection then 
            AimbotConnection:Disconnect() 
            AimbotConnection = nil 
        end
        CrosshairContainer.Visible = false
        Notify("Aimbot Kapatıldı.")
    end
end)
local HitboxConnection
CreateToggle(CombatCard, "Hitbox Expander", "Katilin ve Şerifin kafasını devasa yapar.", 1, function(state)
if state then
HitboxConnection = RunService.RenderStepped:Connect(function()
for _, plr in pairs(Players:GetPlayers()) do
if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
local role = GetRole(plr)
if role == "Murderer" or role == "Sheriff" then
plr.Character.Head.Size = Vector3.new(10, 10, 10)
plr.Character.Head.Transparency = 0.6
plr.Character.Head.CanCollide = false
else
-- Masumları normale döndür
plr.Character.Head.Size = Vector3.new(1.2, 1, 1)
plr.Character.Head.Transparency = 0
end
end
end
end)
Notify("Hitbox Expander Aktif.")
else
if HitboxConnection then HitboxConnection:Disconnect() HitboxConnection = nil end
for _, plr in pairs(Players:GetPlayers()) do
if plr.Character and plr.Character:FindFirstChild("Head") then
plr.Character.Head.Size = Vector3.new(1.2, 1, 1)
plr.Character.Head.Transparency = 0
end
end
Notify("Hitboxlar normale döndü.")
end
end)
