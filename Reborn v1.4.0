OuterRing.ImageColor3 = Color3.fromRGB(0, 255, 0)
OuterRing.Parent = CrosshairContainer

-- Crosshair Renk Güncellemesi ve Efekti
local pulseDir = 1
local pulseScale = 40
RunService.RenderStepped:Connect(function()
    if CrosshairContainer.Visible then
        -- DarkerSH Tema Rengi (Koyu/Parlak Mor)
        local themeColor = Color3.fromRGB(138, 43, 226) 
        CenterDot.BackgroundColor3 = themeColor
        OuterRing.ImageColor3 = themeColor
        
        -- Sürekli dönme ve nefes alma (Pulse) animasyonu
        OuterRing.Rotation = OuterRing.Rotation + 3
        
        pulseScale = pulseScale + (0.4 * pulseDir)
        if pulseScale > 46 then 
            pulseDir = -1 
        elseif pulseScale < 34 then 
            pulseDir = 1 
        end
        
        OuterRing.Size = UDim2.new(0, pulseScale, 0, pulseScale)
        OuterRing.Position = UDim2.new(0.5, -pulseScale/2, 0.5, -pulseScale/2)
    end
end)
