local function CreateQCToggle(name, callback)
    local F = Instance.new("TextButton") 
    F.BackgroundColor3 = Color3.fromRGB(18, 14, 33) -- Panel içi buton arka planı
    F.Text = ""
    F.AutoButtonColor = false
    F.ZIndex = 60
    F.Active = true
    Instance.new("UICorner", F).CornerRadius = UDim.new(0, 6)
    F.Parent = QCGridContainer
    
   local T = Instance.new("TextLabel")
    T.Size = UDim2.new(1, -45, 1, 0) -- YENİ: Yazının butonun üstüne taşmasını engeller
    T.Position = UDim2.new(0, 10, 0, 0)
    T.BackgroundTransparency = 1
    T.Text = name
    T.Font = Enum.Font.GothamMedium
    T.TextColor3 = Color3.fromRGB(210, 210, 220)
    T.TextScaled = true 
    T.TextXAlignment = Enum.TextXAlignment.Left
    T.ZIndex = 61
    T.Parent = F
    
    local UIPadding = Instance.new("UIPadding", T)
    UIPadding.PaddingTop = UDim.new(0, 8)
    UIPadding.PaddingBottom = UDim.new(0, 8)

    local Btn = Instance.new("Frame")
    Btn.Size = UDim2.new(0, 32, 0, 16)
    Btn.Position = UDim2.new(1, -40, 0.5, -8)
    Btn.BackgroundColor3 = Color3.fromRGB(35, 28, 55) -- Tasarımdaki Kapalı switch rengi
    Btn.ZIndex = 61
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(1, 0)
    Btn.Parent = F

    local Circ = Instance.new("Frame")
    Circ.Size = UDim2.new(0, 12, 0, 12)
    Circ.Position = UDim2.new(0, 2, 0, 2)
    Circ.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    Circ.ZIndex = 62
    Instance.new("UICorner", Circ).CornerRadius = UDim.new(1, 0)
    Circ.Parent = Btn
    
    local toggled = false
    F.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            -- AÇILIŞ: Mor renk ve sağa kayma
            TweenService:Create(Btn, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(138, 43, 226)}):Play() 
            TweenService:Create(Circ, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(1, -14, 0, 2), BackgroundColor3 = Color3.fromRGB(255,255,255)}):Play()
        else
            -- KAPANIŞ: Koyu tema rengi ve sola kayma
            TweenService:Create(Btn, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(35, 28, 55)}):Play() 
            TweenService:Create(Circ, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 2, 0, 2), BackgroundColor3 = Color3.fromRGB(200,200,200)}):Play()
        end
        
        local stateStr = toggled and ((currentLang == "TR") and "Açık" or "Enabled") or ((currentLang == "TR") and "Kapalı" or "Disabled")
        local localizedName = (currentLang == "TR") and (enToTr[name] or name) or name
        Notify(localizedName .. ": " .. stateStr)
        
        if callback then pcall(function() callback(toggled) end) end
    end)
end
