-- Sistem Fonksiyonları (Sadeleştirilmiş Aktif Gradient & Renk Kilidi Sistemi)
VerifyAndLoadMenu = function(k, isAuto)
    local tierName = ""

    if k == "Free_4202" then
        UserTierValue = 0; tierName = "FREE"
        TierBadge.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    elseif k:match("^%a%a%a%a%a%a%d%d%d$") then
        UserTierValue = 1; tierName = "LITE"
        TierBadge.BackgroundColor3 = Color3.fromRGB(50, 150, 255)
    elseif k:match("^%a%a%a%a%a%a%a%a%a%a%a%a%d%d%d%d$") then
        UserTierValue = 2; tierName = "PRO"
        TierBadge.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
    else
        if ScreenGui:FindFirstChild("TierSelectionMenu") then
            return false
        elseif IntroKeyInput then
            IntroKeyInput.Text = (currentLang == "TR") and "Geçersiz Anahtar!" or "Invalid Key!"
            task.wait(1)
            IntroKeyInput.Text = ""
            return false
        end
        return false
    end

    pcall(function() writefile("DarkerSH_Key.txt", k) end)
    TierText.Text = tierName

    if KeyContainer then KeyContainer:Destroy() end
    
    for _, item in ipairs(FeatureElements) do
        if UserTierValue < item.Tier then
            item.UI.Visible = false
        else
            item.UI.Visible = true
        end
    end

    -- =========================================================
    -- 1. ARAYÜZÜ SIFIRLAMA (LITE VE FREE İÇİN ESKİ RENKLERİ GERİ YÜKLEME)
    -- =========================================================
    ProHomeContainer.Visible = false
    WelcomeTitle.Visible = true
    StatsFrame.Visible = true
    ProfileFrame.Visible = true
    
    if _G.ProColorLoop then _G.ProColorLoop:Disconnect() _G.ProColorLoop = nil end
    
    if UserTierValue == 0 then -- FREE SÜRÜM
        MainGradient.Enabled = false
        MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    else -- LITE SÜRÜM
        MainGradient.Enabled = true
        MainGradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 10, 50)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(110, 30, 180)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 10, 50))
        }
        MainFrame.BackgroundColor3 = Color3.fromRGB(20, 10, 30)
    end
    
    Sidebar.BackgroundColor3 = Color3.fromRGB(20, 20, 23)
    MainStroke.Color = Color3.fromRGB(255, 255, 255)

    if CloseBtn then
        CloseBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        if CloseBtn:FindFirstChild("CloseGrad") then CloseBtn.CloseGrad.Enabled = false end
    end
    if MinimizeBtn then
        MinimizeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        if MinimizeBtn:FindFirstChild("MinGrad") then MinimizeBtn.MinGrad.Enabled = false end
    end
    
    for _, child in pairs(MainStroke:GetChildren()) do
        if child:IsA("UIGradient") then child:Destroy() end
    end

    if EnBtn and TrBtn then
        EnBtn.BackgroundColor3 = (currentLang == "EN") and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(45, 45, 50)
        TrBtn.BackgroundColor3 = (currentLang == "TR") and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(45, 45, 50)
        EnBtn.TextStrokeTransparency = 1 -- Metin gölgesini varsayılana çevir
        TrBtn.TextStrokeTransparency = 1
        if EnBtn:FindFirstChild("ProWave") then EnBtn.ProWave.Enabled = false end
        if TrBtn:FindFirstChild("ProWave") then TrBtn.ProWave.Enabled = false end
    end

    for tName, tabData in pairs(Tabs) do
        tabData.Button.TextXAlignment = Enum.TextXAlignment.Center
        if tabData.Button:FindFirstChildOfClass("UIPadding") then
            tabData.Button:FindFirstChildOfClass("UIPadding"):Destroy()
        end
        if tabData.Button:FindFirstChild("TabIconLbl") then
            tabData.Button.TabIconLbl:Destroy()
        end
        if tabData.Button:FindFirstChild("TabWaveGradient") then
            tabData.Button.TabWaveGradient:Destroy()
        end
        
        if tabData.Page.Visible then
            tabData.Button.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
            tabData.Button.BackgroundTransparency = 0
            tabData.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            tabData.Button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            tabData.Button.BackgroundTransparency = 0
            tabData.Button.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end
    
    for _, obj in pairs(ProHomeContainer:GetDescendants()) do
        if obj:FindFirstChild("ProWave") then obj.ProWave.Enabled = false end
        
        if obj:IsA("Frame") and obj.Size == UDim2.new(0, 32, 0, 16) then
            local circ = obj:FindFirstChild("Circ")
            obj.BackgroundColor3 = (circ and circ.Position.X.Offset < -5) and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(35, 28, 55)
        end
        if obj.Name == "Circ" then
            obj.BackgroundColor3 = (obj.Position.X.Offset < -5) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        end
    end

    for _, obj in pairs(ContentContainer:GetDescendants()) do
        if obj:FindFirstChild("ProWave") then obj.ProWave.Enabled = false end

        if obj:IsA("UIGradient") and obj.Parent and obj.Parent:IsA("GuiObject") and obj.Parent.BackgroundColor3 == Color3.fromRGB(255, 255, 255) and obj.Name ~= "ProWave" then
            obj.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(25, 5, 40)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 10, 90)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(25, 5, 40))
            }
        end

        if obj:IsA("Frame") and obj.Size == UDim2.new(1, -5, 0, 45) then
            obj.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            obj.BackgroundTransparency = 0
        end
        if obj:IsA("Frame") and obj.Size == UDim2.new(0, 65, 0, 20) then
            obj.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            obj.BackgroundTransparency = 0
        end
        if obj:IsA("Frame") and obj.Size == UDim2.new(0, 36, 0, 18) then
            local circ = obj:FindFirstChild("Circle")
            obj.BackgroundColor3 = (circ and circ.Position.X.Offset < -5) and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(45, 45, 50)
        end
        if obj.Name == "Circle" then
            obj.BackgroundColor3 = (obj.Position.X.Offset < -5) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        end
    end

    -- =========================================================
    -- 2. EĞER YENİ TIER PRO İSE PRO TASARIMINI UYGULA
    -- =========================================================
    if UserTierValue == 2 then
        MainGradient.Enabled = true
        MainGradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(5, 10, 30)),     
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(92, 36, 211)), 
            ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 5, 40))      
        }
        
        ApplyChasingBorder(MainStroke)

        MainFrame.BackgroundColor3 = Color3.fromRGB(10, 12, 25) 
        Sidebar.BackgroundColor3 = Color3.fromRGB(12, 14, 35)   
        
        WelcomeTitle.Visible = false
        StatsFrame.Visible = false
        ProHomeContainer.Visible = true
        ProfileFrame.Visible = false

        if CloseBtn then
            CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            if CloseBtn:FindFirstChild("CloseGrad") then CloseBtn.CloseGrad.Enabled = true end
        end
        if MinimizeBtn then
            MinimizeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            if MinimizeBtn:FindFirstChild("MinGrad") then MinimizeBtn.MinGrad.Enabled = true end
        end

        -- ==== DİNAMİK RENK ŞEMALARI ====
        local proColorSeq = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(5, 10, 30)),     -- Koyu Gece Laciverti
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(30, 10, 45)),  -- Gece Yarısı Moru
            ColorSequenceKeypoint.new(1, Color3.fromRGB(5, 10, 30))
        }
        
        local activeBtnSeq = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 10, 45)),    -- Gece Moru
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(110, 30, 180)),-- Canlı Mor
            ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 10, 45))
        }
        
        local dotActiveSeq = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 5, 40)),     -- Koyu Gece Moru
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(138, 43, 226)),-- Mor
            ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 5, 40))
        }

        local function CreateOrGetWave(obj, seq, speed)
            local grad = obj:FindFirstChild("ProWave") or Instance.new("UIGradient")
            grad.Name = "ProWave"
            grad.Color = seq
            grad.Parent = obj
            
            if not obj:FindFirstChild("WaveAnimStarted") then
                Instance.new("BoolValue", obj).Name = "WaveAnimStarted"
                TweenService:Create(grad, TweenInfo.new(speed or 2.5, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true), {Offset = Vector2.new(-1, 0)}):Play()
            end
            return grad
        end

        -- Sabit Özellik Kutularını ve Çerçeveleri Ayarla
        for _, obj in pairs(ProHomeContainer:GetDescendants()) do
            if (obj:IsA("Frame") or obj:IsA("TextButton")) and (obj.BackgroundColor3 == Color3.fromRGB(20, 5, 35) or obj.BackgroundColor3 == Color3.fromRGB(20, 15, 35) or obj.BackgroundColor3 == Color3.fromRGB(23, 18, 43) or obj.BackgroundColor3 == Color3.fromRGB(18, 14, 33) or obj.BackgroundColor3 == Color3.fromRGB(18, 16, 42)) then
                obj.BackgroundColor3 = Color3.fromRGB(18, 16, 42)
                obj.BackgroundTransparency = 0.1 
            end
        end

        -- 1. Dil (Language) Butonları Animasyonu (AÇIKKEN HAREKETLİ, KAPALIYKEN SABİT)
        local function ApplyLangBtnBehavior(btn, langCode)
            local grad = CreateOrGetWave(btn, activeBtnSeq, 1.5)
            btn.TextStrokeTransparency = 0.3 -- Yazının daha belirgin olması için metin gölgesi
            btn.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            
            local function updateState()
                if UserTierValue == 2 then
                    if currentLang == langCode then
                        grad.Enabled = true
                        btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    else
                        grad.Enabled = false
                        btn.BackgroundColor3 = Color3.fromRGB(25, 18, 35) -- Sabit Pasif Renk
                    end
                end
            end
            
            updateState()
            if not btn:FindFirstChild("LangLock") then
                Instance.new("BoolValue", btn).Name = "LangLock"
                btn:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
                    if UserTierValue == 2 and btn.BackgroundColor3 == Color3.fromRGB(138, 43, 226) then
                        updateState()
                    end
                end)
            end
        end

        if EnBtn and TrBtn then
            ApplyLangBtnBehavior(EnBtn, "EN")
            ApplyLangBtnBehavior(TrBtn, "TR")
        end

        -- 2. Switch Noktaları (AÇIKKEN HAREKETLİ, KAPALIYKEN SABİT)
        local function ApplySwitchBehavior(obj)
            local grad = CreateOrGetWave(obj, dotActiveSeq, 1.5)
            
            local function updateState()
                if UserTierValue == 2 then
                    if obj.Position.X.Offset < -5 then 
                        grad.Enabled = true
                        obj.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    else
                        grad.Enabled = false
                        obj.BackgroundColor3 = Color3.fromRGB(200, 200, 200) 
                    end
                end
            end
            
            updateState()
            
            if not obj:FindFirstChild("SwitchLock") then
                Instance.new("BoolValue", obj).Name = "SwitchLock"
                obj:GetPropertyChangedSignal("Position"):Connect(updateState)
            end
        end

        for _, obj in pairs(ContentContainer:GetDescendants()) do
            if obj:IsA("Frame") and obj.Size == UDim2.new(1, -5, 0, 45) then
                obj.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                obj.BackgroundTransparency = 0.25 
                CreateOrGetWave(obj, proColorSeq).Enabled = true
            end
            
            -- NORMAL BUTONLARIN (Action Butonları) TIKLANINCA KOYULAŞMASINI ENGELLEYEN SİSTEM
            if obj:IsA("Frame") and obj.Size == UDim2.new(0, 65, 0, 20) then
                obj.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                obj.BackgroundTransparency = 0
                CreateOrGetWave(obj, proColorSeq).Enabled = true
                
                -- Tıklanma animasyonu arka planı gri/koyu mor yapmaya çalıştığında beyazda tutar
                if not obj:FindFirstChild("ActionBtnLock") then
                    Instance.new("BoolValue", obj).Name = "ActionBtnLock"
                    obj:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
                        if UserTierValue == 2 and obj.BackgroundColor3 ~= Color3.fromRGB(255, 255, 255) then
                            obj.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                        end
                    end)
                end
            end
            
            if obj:IsA("UIStroke") and obj.Parent and obj.Parent:IsA("Frame") and (obj.Parent.BackgroundColor3 == Color3.fromRGB(255, 255, 255) or obj.Parent.Size == UDim2.new(0, 65, 0, 20)) then
                CreateOrGetWave(obj, proColorSeq).Enabled = true
            end

            if obj.Name == "Circle" then
                ApplySwitchBehavior(obj)
            end
        end

        for _, obj in pairs(ProHomeContainer:GetDescendants()) do
            if obj.Name == "Circ" then
                ApplySwitchBehavior(obj)
            end
        end
        
        -- Sekmeler (Tabs)
        local tabIcons = {
            ["Ana Menü"] = "rbxassetid://6022668888", ["Farm"] = "rbxassetid://6023282396", 
            ["Oyuncu"] = "rbxassetid://6022668888", ["Savaş"] = "rbxassetid://6023282396", 
            ["Görsel"] = "rbxassetid://6022668888", ["Işınlanma"] = "rbxassetid://6023282396", 
            ["Groq AI"] = "rbxassetid://6022668888", ["Ayarlar"] = "rbxassetid://6023282396"
        }
        
        for tName, tabData in pairs(Tabs) do
            tabData.Button.TextXAlignment = Enum.TextXAlignment.Left
            local pad = Instance.new("UIPadding", tabData.Button)
            pad.PaddingLeft = UDim.new(0, 35)
            
            local IconLbl = Instance.new("ImageLabel")
            IconLbl.Name = "TabIconLbl"
            IconLbl.Size = UDim2.new(0, 18, 0, 18)
            IconLbl.Position = UDim2.new(0, -26, 0.5, -9) 
            IconLbl.BackgroundTransparency = 1
            IconLbl.Image = tabIcons[tName] or "rbxassetid://6022668888"
            IconLbl.Parent = tabData.Button

            local TabGrad = Instance.new("UIGradient")
            TabGrad.Name = "TabWaveGradient"
            TabGrad.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 10, 60)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160, 32, 240)), 
                ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 10, 60))
            }
            TabGrad.Parent = tabData.Button
            
            if tabData.Page.Visible then
                tabData.Button.BackgroundTransparency = 1
                TabGrad.Enabled = true
                tabData.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
                IconLbl.ImageColor3 = Color3.fromRGB(255, 255, 255)
            else
                tabData.Button.BackgroundTransparency = 1
                TabGrad.Enabled = false
                tabData.Button.TextColor3 = Color3.fromRGB(150, 150, 160)
                IconLbl.ImageColor3 = Color3.fromRGB(150, 150, 160)
            end
            
            if not tabData.Button:FindFirstChild("EventConnected") then
                local marker = Instance.new("BoolValue", tabData.Button)
                marker.Name = "EventConnected"
                tabData.Button:GetPropertyChangedSignal("TextColor3"):Connect(function()
                    if tabData.Button.TextColor3 == Color3.fromRGB(255, 255, 255) then
                        IconLbl.ImageColor3 = Color3.fromRGB(255, 255, 255)
                    else
                        IconLbl.ImageColor3 = Color3.fromRGB(150, 150, 160)
                    end
                end)
            end
        end
        Title.Text = "DarkerSH"
    end

    -- =========================================================
    -- 3. ARAYÜZÜN YENİDEN YÜKLENMESİ VE SİNEMATİK SONUÇ
    -- =========================================================
    if not isAuto then
        local welcomeMsg = (currentLang == "TR") and ("Hoş Geldiniz, \n" .. tierName .. " Tanımlandı") or ("Welcome, \n" .. tierName .. " Granted")
        
        if IntroFrame and IntroFrame.Parent then
            WelcomeText.Text = welcomeMsg
            WelcomeText.Visible = true
            TweenService:Create(WelcomeText, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
            task.wait(2) 
            local fadeOutInfo = TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            TweenService:Create(IntroFrame, fadeOutInfo, {BackgroundTransparency = 1}):Play()
            TweenService:Create(WelcomeText, fadeOutInfo, {TextTransparency = 1}):Play()
            task.wait(1)
            if IntroFrame then IntroFrame:Destroy() end
        end
    else
        if IntroFrame then IntroFrame:Destroy() end
    end

    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    MainFrame.Visible = true
    TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = CurrentUIWindowSize}):Play()
    
    return true
end
IntroVerifyBtn.MouseButton1Click:Connect(function()
    VerifyAndLoadMenu(IntroKeyInput.Text, false)
end)

task.spawn(function()
    local savedKey = nil
    pcall(function() savedKey = readfile("DarkerSH_Key.txt") end)
    
    if savedKey and savedKey ~= "" then
        task.wait(0.5) 
        VerifyAndLoadMenu(savedKey, true)
        Notify("Otomatik Giriş Yapıldı: " .. savedKey)
    end
end)
