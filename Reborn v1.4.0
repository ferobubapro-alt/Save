CrossColor = colors[cIndex] -- Global atama

CreateButton(SettingsCard, "Crosshair Rengi", "Aimbot nişangahının rengini değiştirir.", 0, "YEŞİL", function(btnTxt)
    cIndex = cIndex + 1
    if cIndex > #colors then cIndex = 1 end

    CrossColor = colors[cIndex]
    btnTxt.Text = colorNames[cIndex]
    btnTxt.TextColor3 = colors[cIndex]
end)
-- 4. TIER (SÜRÜM) DEĞİŞTİRME SİSTEMİ
CreateButton(SettingsCard, "Sürüm Değiştir (Tier)", "Sahip olduğunuz yetkiye göre alt sürümlere geçebilirsiniz.", 0, "GEÇİŞ YAP", function(btnTxt)
    -- Eğer önceden açılmış bir menü varsa engelle
    if ScreenGui:FindFirstChild("TierSelectionMenu") then return end

    -- Ana Menü Çerçevesi
    local TierMenu = Instance.new("Frame")
    TierMenu.Name = "TierSelectionMenu"
    TierMenu.Size = UDim2.new(0, 450, 0, 280)
    TierMenu.AnchorPoint = Vector2.new(0.5, 0.5)
    -- Ekranın solundan başlatıyoruz (Kayarak gelme efekti için)
    TierMenu.Position = UDim2.new(-0.5, 0, 0.5, 0)
    TierMenu.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    TierMenu.ZIndex = 500
    Instance.new("UICorner", TierMenu).CornerRadius = UDim.new(0, 12)
    TierMenu.Parent = ScreenGui

    -- Dış Çerçeve (Stroke)
    local TierStroke = Instance.new("UIStroke", TierMenu)
    TierStroke.Color = Color3.fromRGB(138, 43, 226)
    TierStroke.Thickness = 1.5

    -- Koyu Lacivert ve Gece Yarısı Moru Gradient (Hareketli)
    local TierGradient = Instance.new("UIGradient")
    TierGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(5, 10, 25)),    -- Koyu Lacivert
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(30, 10, 45)), -- Gece Yarısı Moru
        ColorSequenceKeypoint.new(1, Color3.fromRGB(5, 10, 25))
    }
    TierGradient.Rotation = 45
    TierGradient.Parent = TierMenu
    
    local waveTween = TweenService:Create(TierGradient, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Offset = Vector2.new(0.5, 0)})
    waveTween:Play()

    -- Başlık
    local MenuTitle = Instance.new("TextLabel")
    MenuTitle.Size = UDim2.new(1, -20, 0, 40)
    MenuTitle.Position = UDim2.new(0, 20, 0, 10)
    MenuTitle.BackgroundTransparency = 1
    MenuTitle.Text = "SÜRÜM (TIER) SEÇİMİ"
    MenuTitle.Font = Enum.Font.GothamBlack
    MenuTitle.TextColor3 = Color3.fromRGB(200, 180, 255)
    MenuTitle.TextSize = 16
    MenuTitle.TextXAlignment = Enum.TextXAlignment.Left
    MenuTitle.ZIndex = 501
    MenuTitle.Parent = TierMenu

    -- Kapatma Butonu
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Position = UDim2.new(1, -40, 0, 15)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(40, 20, 40)
    CloseBtn.Text = "X"
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    CloseBtn.TextSize = 14
    CloseBtn.ZIndex = 501
    Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)
    CloseBtn.Parent = TierMenu

    -- Sağ Kısım (Tier Seçenekleri)
    local TierListFrame = Instance.new("Frame")
    TierListFrame.Size = UDim2.new(0, 140, 0, 180)
    TierListFrame.Position = UDim2.new(1, -160, 0, 70)
    TierListFrame.BackgroundTransparency = 1
    TierListFrame.ZIndex = 501
    TierListFrame.Parent = TierMenu

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Padding = UDim.new(0, 15)
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Parent = TierListFrame

    -- Sol Kısım (Key Girişi ve Onay)
    local KeyInput = Instance.new("TextBox")
    KeyInput.Size = UDim2.new(0, 240, 0, 40)
    KeyInput.Position = UDim2.new(0, 20, 0, 110)
    KeyInput.BackgroundColor3 = Color3.fromRGB(20, 15, 30)
    KeyInput.Text = ""
    KeyInput.Font = Enum.Font.Gotham
    KeyInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    KeyInput.TextSize = 12
    KeyInput.ZIndex = 501
    Instance.new("UICorner", KeyInput).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", KeyInput).Color = Color3.fromRGB(138, 43, 226)
    KeyInput.Parent = TierMenu

    local ApplyBtn = Instance.new("TextButton")
    ApplyBtn.Size = UDim2.new(0, 240, 0, 40)
    ApplyBtn.Position = UDim2.new(0, 20, 0, 165)
    ApplyBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
    ApplyBtn.Text = "LOG-IN"
    ApplyBtn.Font = Enum.Font.GothamBold
    ApplyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ApplyBtn.TextSize = 14
    ApplyBtn.ZIndex = 501
    Instance.new("UICorner", ApplyBtn).CornerRadius = UDim.new(0, 6)
    ApplyBtn.Parent = TierMenu

    -- MEVCUT SÜRÜMÜ GİZLEYEN BUTON SİSTEMİ
    local TierButtons = {}
    local currentTierName = TierNames[UserTierValue] -- Şu anki sürümün ismini alır
    local SelectedTierStr = ""
    
    local function CreateTierOption(name, color, order)
        if name == currentTierName then return end -- ŞU ANKİ SÜRÜMÜ MENÜYE EKLEME
        
        local TBtn = Instance.new("TextButton")
        TBtn.Size = UDim2.new(1, 0, 0, 45)
        TBtn.BackgroundColor3 = Color3.fromRGB(25, 20, 35)
        TBtn.Text = name
        TBtn.Font = Enum.Font.GothamBlack
        TBtn.TextColor3 = Color3.fromRGB(150, 150, 160)
        TBtn.TextSize = 16
        TBtn.LayoutOrder = order
        TBtn.ZIndex = 501
        Instance.new("UICorner", TBtn).CornerRadius = UDim.new(0, 8)
        
        local Stroke = Instance.new("UIStroke", TBtn)
        Stroke.Color = color
        Stroke.Thickness = 1
        Stroke.Transparency = 0.5
        
        TBtn.Parent = TierListFrame
        TierButtons[name] = TBtn

        TBtn.MouseButton1Click:Connect(function()
            SelectedTierStr = name
            KeyInput.PlaceholderText = name .. " Keyinizi girin..."
            
            for btnName, btn in pairs(TierButtons) do
                if btnName == name then
                    TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = color, TextColor3 = Color3.fromRGB(255,255,255)}):Play()
                    btn.UIStroke.Transparency = 0
                else
                    TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 20, 35), TextColor3 = Color3.fromRGB(150, 150, 160)}):Play()
                    btn.UIStroke.Transparency = 0.5
                end
            end
        end)
    end

    CreateTierOption("PRO", Color3.fromRGB(138, 43, 226), 1)
    CreateTierOption("LITE", Color3.fromRGB(50, 150, 255), 2)
    CreateTierOption("FREE", Color3.fromRGB(100, 100, 100), 3)

    -- Dinamik varsayılan seçimi ayarla (PRO'daysa LITE seçili başlasın vs.)
    SelectedTierStr = "PRO"
    if currentTierName == "PRO" then SelectedTierStr = "LITE" end
    if currentTierName == "PRO" and UserTierValue == 1 then SelectedTierStr = "PRO" end 
    
    if TierButtons[SelectedTierStr] then
        local defColor = (SelectedTierStr == "PRO" and Color3.fromRGB(138, 43, 226)) or (SelectedTierStr == "LITE" and Color3.fromRGB(50, 150, 255)) or Color3.fromRGB(100, 100, 100)
        TierButtons[SelectedTierStr].BackgroundColor3 = defColor
        TierButtons[SelectedTierStr].TextColor3 = Color3.fromRGB(255, 255, 255)
        TierButtons[SelectedTierStr].UIStroke.Transparency = 0
    end
    
    KeyInput.PlaceholderText = SelectedTierStr .. " Keyinizi girin..."

    -- Soldan kayarak gelme animasyonu
    TweenService:Create(TierMenu, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()

    local function CloseMenu()
        TweenService:Create(TierMenu, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Position = UDim2.new(1.5, 0, 0.5, 0)}):Play()
        task.wait(0.4)
        waveTween:Cancel()
        TierMenu:Destroy()
    end
    CloseBtn.MouseButton1Click:Connect(CloseMenu)

    -- Eriyerek Yok Olma Efekti (Melt Effect)
    local function MeltAway()
        -- Çerçevenin hafifçe aşağı kayması ve görünmez olması
        TweenService:Create(TierMenu, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, 0, 0.55, 0),
            BackgroundTransparency = 1
        }):Play()

        -- İçindeki tüm objelerin şeffaflaşması
        for _, obj in pairs(TierMenu:GetDescendants()) do
            if obj:IsA("GuiObject") then
                pcall(function() TweenService:Create(obj, TweenInfo.new(1), {BackgroundTransparency = 1}):Play() end)
                if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    pcall(function() TweenService:Create(obj, TweenInfo.new(1), {TextTransparency = 1}):Play() end)
                end
                if obj:IsA("UIStroke") then
                    pcall(function() TweenService:Create(obj, TweenInfo.new(1), {Transparency = 1}):Play() end)
                end
            end
        end

        task.wait(1.2)
        waveTween:Cancel()
        TierMenu:Destroy()
    end

    -- Giriş Yap Butonu Mantığı
    ApplyBtn.MouseButton1Click:Connect(function()
        local inputKey = KeyInput.Text
        local isValid = false

        -- Key Regex Kontrolleri
        if SelectedTierStr == "FREE" and inputKey == "Free_4202" then isValid = true
        elseif SelectedTierStr == "LITE" and inputKey:match("^%a%a%a%a%a%a%d%d%d$") then isValid = true
        elseif SelectedTierStr == "PRO" and inputKey:match("^%a%a%a%a%a%a%a%a%a%a%a%a%d%d%d%d$") then isValid = true
        end

        if isValid then
            ApplyBtn.Text = "BAŞARILI!"
            ApplyBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
            
            -- Erime efektini başlat
            MeltAway()
            
            -- Ana sistem fonksiyonunu çağırarak arayüzü yeni yetkiye göre güncelle
            VerifyAndLoadMenu(inputKey, false)
            Notify("Başarıyla " .. SelectedTierStr .. " sürümüne geçildi!")
        else
            KeyInput.Text = ""
            KeyInput.PlaceholderText = "Geçersiz Key!"
            ApplyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            task.wait(1)
            ApplyBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
            KeyInput.PlaceholderText = SelectedTierStr .. " Keyinizi girin..."
        end
    end)
end)

