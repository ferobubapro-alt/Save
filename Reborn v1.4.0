ColorSequenceKeypoint.new(1, Color3.fromRGB(25, 5, 40))
}
CardGradient.Rotation = 45
CardGradient.Parent = CardFrame

TweenService:Create(CardGradient, TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Offset = Vector2.new(0.5, 0)}):Play()

local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(255, 255, 255)
Stroke.Transparency = 0.7
Stroke.Thickness = 1
Stroke.Parent = CardFrame

local TitleLbl = Instance.new("TextLabel")
