SafeText.TextXAlignment = Enum.TextXAlignment.Right
SafeText.ZIndex = 6
SafeText.Parent = TopBar
local animPhrases = {
    {"Safe,", "Fast,", "Undetected."},
    {"Optimized,", "Privileged,", "Humanized."},
    {"Zero", "Detection,", "Bypass."},
    {"24/7", "Support."}
}

task.spawn(function()
    local phraseIndex = 1
    while true do
        local currentWords = animPhrases[phraseIndex]
        local currentText = ""
        SafeText.Text = ""
        
        for i, word in ipairs(currentWords) do
            local prefix = (i == 1) and "" or " "
            local wordToType = prefix .. word
            
            for j = 1, #wordToType do
                currentText = currentText .. string.sub(wordToType, j, j)
                SafeText.Text = currentText
                
                pcall(function()
                    if ScreenGui:FindFirstChild("ProStatusAnimText", true) then
                        ScreenGui:FindFirstChild("ProStatusAnimText", true).Text = currentText
                    end
                end)
                
                task.wait(0.04)
            end
            task.wait(0.5) -- KELİMELER ARASI BEKLEME SÜRESİ (EKLENDİ)
        end -- İÇ DÖNGÜYÜ KAPATAN END (EKLENDİ, EKSİKTİ)
        
        task.wait(2.5)
        phraseIndex = phraseIndex + 1
        if phraseIndex > #animPhrases then phraseIndex = 1 end
    end
end)

