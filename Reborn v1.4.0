local function ChangeLang(lang)
    if currentLang == lang then return end
    currentLang = lang

    -- Buton renklerini anında güncelle
    EnBtn.BackgroundColor3 = (currentLang == "EN") and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(45, 45, 50)
    TrBtn.BackgroundColor3 = (currentLang == "TR") and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(45, 45, 50)

    -- Menüyü kapat-aç efekti
    TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
    task.wait(0.4)
    MainFrame.Visible = false
    UpdateLanguage() 
    task.wait(0.2)
    MainFrame.Visible = true
    TweenService:Create(MainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 800, 0, 520)}):Play()
    Notify("Language updated to " .. currentLang)
end

EnBtn.MouseButton1Click:Connect(function() ChangeLang("EN") end)
TrBtn.MouseButton1Click:Connect(function() ChangeLang("TR") end)
-- 3. CROSSHAIR RENK SEÇİMİ
local colors = {Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 255, 0), Color3.fromRGB(255, 255, 255)}
local colorNames = {"YEŞİL", "KIRMIZI", "SARI", "BEYAZ"}
