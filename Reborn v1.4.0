local enToTr = {}
for k, v in pairs(trToEn) do enToTr[v] = k end

local function TranslateGUI(isTR)
    local targetDict = isTR and enToTr or trToEn
    for _, obj in pairs(ContentContainer:GetDescendants()) do
        if obj:IsA("TextLabel") and (obj.Name == "TitleLbl" or obj.Name == "DescLbl") then
            if targetDict[obj.Text] then obj.Text = targetDict[obj.Text] end
        end
    end
end

local function UpdateLanguage()
    if currentLang == "TR" then
        if WelcomeTitle then WelcomeTitle.Text = "MM2'yi Bu Yazılımımız İle Domine Et." end
        pcall(function()
            Tabs["Ana Menü"].Button.Text = "Ana Menü"
            Tabs["Farm"].Button.Text = "Farm"; Tabs["Oyuncu"].Button.Text = "Oyuncu"
            Tabs["Savaş"].Button.Text = "Savaş"; Tabs["Görsel"].Button.Text = "Görsel"
            Tabs["Işınlanma"].Button.Text = "Işınlanma"; Tabs["Groq AI"].Button.Text = "Asistan AI"
            Tabs["Ayarlar"].Button.Text = "Ayarlar"
        end)
        
        if AIInputBox then AIInputBox.PlaceholderText = "Asistana komutunuzu yazın..." end
        if AISendBtn then AISendBtn.Text = "GÖNDER" end
        if ModeToggleBtn then ModeToggleBtn.Text = (aiMode == "Chat") and "Sohbet Modu" or "Kod Modu" end
        if ModeDesc then ModeDesc.Text = (aiMode == "Chat") and "Asistan sizinle sadece sohbet eder." or "Asistan anında hile komutlarını çalıştırır." end
        
        -- PRO MENU ÇEVİRİLERİ (DİNAMİK YAZILAR) ÇÖKME DÜZELTİLDİ
        if ProWelcome then ProWelcome.Text = "<font color=\"rgb(157,78,221)\">DarkerSH</font>'a Hoş Geldiniz" end
        if ProSub then ProSub.Text = "Oyunu domine etmeniz için hepsi bir arada merkeziniz." end
        if StatusTitle then StatusTitle.Text = "Durum: Tespit Edilmedi" end
        if StatusDate then StatusDate.Text = "Son Güncelleme: Bugün" end
        if CmdInput then CmdInput.PlaceholderText = ">_ Bir komut yazın..." end
        if CmdExec then CmdExec.Text = "▶ Çalıştır" end
        
        TranslateGUI(true)
    else
        if WelcomeTitle then WelcomeTitle.Text = "Dominate MM2 With Our Soft-Ware" end
        pcall(function()
            Tabs["Ana Menü"].Button.Text = "Home"
            Tabs["Farm"].Button.Text = "Farm"; Tabs["Oyuncu"].Button.Text = "Player"
            Tabs["Savaş"].Button.Text = "Combat"; Tabs["Görsel"].Button.Text = "Visual"
            Tabs["Işınlanma"].Button.Text = "Teleport"; Tabs["Groq AI"].Button.Text = "Assistant AI"
            Tabs["Ayarlar"].Button.Text = "Settings"
        end)
        
        if AIInputBox then AIInputBox.PlaceholderText = "Type your command to the assistant..." end
        if AISendBtn then AISendBtn.Text = "SEND" end
        if ModeToggleBtn then ModeToggleBtn.Text = (aiMode == "Chat") and "Chat Mode" or "Code Mode" end
        if ModeDesc then ModeDesc.Text = (aiMode == "Chat") and "Assistant only chats with you." or "Assistant directly executes commands." end
        
        -- PRO MENU ÇEVİRİLERİ (DİNAMİK YAZILAR) ÇÖKME DÜZELTİLDİ
        if ProWelcome then ProWelcome.Text = "<font color=\"rgb(157,78,221)\">DarkerSH</font> Welcome" end
        if ProSub then ProSub.Text = "Your all-in-one hub for dominating the game." end
        if StatusTitle then StatusTitle.Text = "Status: Undetected" end
        if StatusDate then StatusDate.Text = "Last Updated: Today" end
        if CmdInput then CmdInput.PlaceholderText = ">_ Type a command..." end
        if CmdExec then CmdExec.Text = "▶ Execute" end
        
        TranslateGUI(false)
    end
end
UpdateLanguage()
