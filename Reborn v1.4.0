local FpsVal = CreateStatCard("FPS", "60")
local PingVal = CreateStatCard("GECİKME (PING)", "0 ms")
local RegionVal = CreateStatCard("SUNUCU LOKASYON", "Yükleniyor...")
local TimeVal = CreateStatCard("OYUN SÜRESİ", "00:00")
local FriendVal = CreateStatCard("ARKADAŞ DURUMU", "Yok")

-- Gerçek Sunucu Lokasyonu için API İsteği
local RealRegion = "Yükleniyor..."
task.spawn(function()
    local req = (syn and syn.request) or request or http_request or nil
    if req then
        pcall(function()
            -- IP üzerinden gerçek sunucu/istemci lokasyonunu çeker
            local response = req({Url = "http://ip-api.com/json/", Method = "GET"})
            if response and response.Body then
                local data = game:GetService("HttpService"):JSONDecode(response.Body)
                if data and data.country and data.city then
                    RealRegion = data.country .. " (" .. data.city .. ")"
                end
            end
        end)
    else
        RealRegion = "Bilinmiyor (API Desteklenmiyor)"
    end
end)

local StartTime = os.time()
RunService.RenderStepped:Connect(function(dt)
    if HomeTab.Visible then
        -- dt (DeltaTime) kullanarak Gerçek İstemci (Client) FPS'ini net olarak hesaplar
        FpsVal.Text = tostring(math.floor(1 / dt)) .. " FPS"
        
        -- Gerçek Ping Değeri (Hata vermemesi için pcall ile korundu)
        local ping = 0
        pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        PingVal.Text = tostring(math.floor(ping)) .. " ms"
        
        -- Dinamik çekilen gerçek lokasyon
        RegionVal.Text = RealRegion

        local passed = os.time() - StartTime
        local mins = math.floor(passed / 60)
        local secs = passed % 60
        TimeVal.Text = string.format("%02d:%02d", mins, secs)

        local hasFriend = false
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and LocalPlayer:IsFriendsWith(p.UserId) then
                hasFriend = true; break
            end
        end
        FriendVal.Text = hasFriend and "Sunucuda Arkadaş Var" or "Yok"
    end
end)
-- ==========================================
-- BİRBİRİNİ KOVALAYAN ÇİZGİ (CHASING BORDER) SİSTEMİ
-- ==========================================
local chasingStrokes = {}
local function ApplyChasingBorder(targetStroke)
    local Gradient = Instance.new("UIGradient")
    Gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(15, 5, 25)), -- Koyu Siyahımsı Mor
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160, 32, 240)), -- Parlak Mor
        ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 5, 25))
    }
    Gradient.Parent = targetStroke
    table.insert(chasingStrokes, Gradient)
end

RunService.RenderStepped:Connect(function(dt)
    for _, grad in ipairs(chasingStrokes) do
        if grad.Parent then
            grad.Rotation = (grad.Rotation + (dt * 150)) % 360
        end
    end
end)
