local FloatingWidgets = {}
local FeatureElements = {} -- YENİ: Özellikleri yetkiye göre gizlemek için kullanacağız
                              
local function CreateCategoryCard(parentTab, titleText)
local CardFrame = Instance.new("Frame")
CardFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
CardFrame.ZIndex = 3
CardFrame.Parent = parentTab
Instance.new("UICorner", CardFrame).CornerRadius = UDim.new(0, 8)

