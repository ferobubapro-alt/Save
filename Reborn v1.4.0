local function Typewrite(text)
    AIResponseText.Text = ""
    AIResponseText.Visible = true
    for i = 1, #text do
        AIResponseText.Text = string.sub(text, 1, i)
        task.wait(0.015) 
    end
end

local isThinking = false
local function PlayThinkingAnimation()
    isThinking = true
    AIResponseText.Visible = false
    ThinkingFrame.Visible = true
    task.spawn(function()
        while isThinking do
            for i, dot in ipairs(dots) do
                TweenService:Create(dot, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = UDim2.new(0, (i-1)*15, 0.5, -12)}):Play()
                task.wait(0.15)
                TweenService:Create(dot, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Position = UDim2.new(0, (i-1)*15, 0.5, -4)}):Play()
            end
            task.wait(0.2)
        end
    end)
end

local function StopThinkingAnimation()
    isThinking = false
    ThinkingFrame.Visible = false
end

local function GetSystemContext()
    local langIns = (currentLang == "TR") and "Kullanıcının seçtiği dil TÜRKÇE. Tüm cevaplarını ve diyaloglarını kesinlikle Türkçe vereceksin!" or "User language is ENGLISH. You must reply entirely in English!"
    local basePrompt = "Sen DarkerSH adlı Roblox Exploit'inin entegre Asistanısın. " .. langIns .. " "

    if aiMode == "Code" then
        return basePrompt .. [[Kullanıcı senden oyunda doğrudan (ESP aç, uçmamı sağla, zıplat vb.) bir özellik istiyorsa, SADECE roblox'ta anında çalışacak yerel (LocalPlayer) scriptini ver. UI kodları ekleme. Ancak açıkça 'Bunu menüme özellik olarak ekle' derse CreateToggle kullanabilirsin. Kodu SADECE ```lua içine yaz. Başka sohbet etme.]]
    else
        return basePrompt .. "Sohbet modundasın. Çok kısa, samimi ve asistan gibi konuş. Kod yazma."
    end
end

local function RequestDarkerAI(prompt)
    local req = (syn and syn.request) or request or http_request or nil
    if not req then
        Typewrite((currentLang == "TR") and "Hata: Exploitiniz HTTP Request desteklemiyor!" or "Error: Your exploit doesn't support HTTP Requests!")
        return
    end

    PlayThinkingAnimation()

    task.spawn(function()
        -- İstek atarken çökme olursa sistemi kitlememesi için pcall (hata yakalayıcı) ekledik.
        local success, response = pcall(function()
            return req({
                Url = "https://api.groq.com/openai/v1/chat/completions", -- BOZUK LİNK BURADA DÜZELTİLDİ
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json", 
                    ["Authorization"] = "Bearer " .. GroqAPIKey
                },
                Body = HttpService:JSONEncode({
                    model = "llama-3.3-70b-versatile",
                    messages = {
                        {role = "system", content = GetSystemContext()}, 
                        {role = "user", content = prompt}
                    }
                })
            })
        end)

        StopThinkingAnimation()

        if success and response and response.Success then
            local data = HttpService:JSONDecode(response.Body)
            
            -- API'den gelen verinin boş olup olmadığını kontrol et
            if data and data.choices and data.choices[1] then
                local aiReply = data.choices[1].message.content

                if aiMode == "Code" and aiReply:find("```lua") then
                    local codeBlock = aiReply:match("```lua\n(.-)```") or aiReply:match("```lua(.-)```")
                    if codeBlock then
                        local func, err = loadstring(codeBlock)
                        if func then
                            task.spawn(func)
                            Typewrite((currentLang == "TR") and "İstediğiniz komut başarıyla çalıştırıldı!" or "Your command was executed successfully!")
                        else
                            Typewrite((currentLang == "TR") and "Hata oluştu: " .. tostring(err) or "Execution error: " .. tostring(err))
                        end
                    else
                        Typewrite((currentLang == "TR") and "Kodu çalıştıramadım." or "Failed to extract code.")
                    end
                else
                    Typewrite(aiReply)
                end
            else
                Typewrite((currentLang == "TR") and "AI'dan eksik veri geldi." or "Received incomplete data from AI.")
            end
        else
            -- API hatası veya geçersiz istek olursa bunu ekrana yazdıracak
            local errDetail = response and (type(response) == "table" and tostring(response.StatusCode) or tostring(response)) or "Bilinmeyen Hata"
            Typewrite("API Bağlantı Hatası: " .. errDetail)
        end
    end)
end
AISendBtn.MouseButton1Click:Connect(function()
    local maxLimit = (UserTierValue == 2) and 20 or ((UserTierValue == 1) and 10 or 3)
    if aiMessageCount >= maxLimit then
        Typewrite((currentLang == "TR") and "Günlük AI limitinize ulaştınız ("..maxLimit.." Mesaj). Daha fazlası için Tier yükseltin." or "You reached your AI limit ("..maxLimit.." Messages). Upgrade Tier for more.")
        return
    end

    local txt = AIInputBox.Text
    if txt ~= "" then
        aiMessageCount = aiMessageCount + 1
        AIInputBox.Text = ""
        RequestDarkerAI(txt)
    end
end)
