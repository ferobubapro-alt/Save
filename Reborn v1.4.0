FlyConnection = RunService.RenderStepped:Connect(function()
if char and char:FindFirstChild("Humanoid") and hrp:FindFirstChild("FlyBV") then
local cam = Workspace.CurrentCamera
local moveDir = char.Humanoid.MoveDirection

if moveDir.Magnitude > 0 then
local flatLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z).Unit
local flatRight = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z).Unit
local forwardInput = flatLook:Dot(moveDir)
local rightInput = flatRight:Dot(moveDir)
local moveVector = (cam.CFrame.LookVector * forwardInput) + (cam.CFrame.RightVector * rightInput)
hrp.FlyBV.Velocity = moveVector * FlySpeed

if IdleAnimTrack and IdleAnimTrack.IsPlaying then IdleAnimTrack:Stop() end
if MoveAnimTrack and not MoveAnimTrack.IsPlaying then MoveAnimTrack:Play() end
else
hrp.FlyBV.Velocity = Vector3.new(0, 0, 0)
if MoveAnimTrack and MoveAnimTrack.IsPlaying then MoveAnimTrack:Stop() end
if IdleAnimTrack and not IdleAnimTrack.IsPlaying then IdleAnimTrack:Play() end
end
hrp.FlyBG.CFrame = cam.CFrame
end
end)
else
StopFly()
end
end)

local safeIsHiding = false
local safePos = nil
local safePlatform = nil -- Havada üzerinde yürüyeceğin zemin

CreateToggle(UtilityCard, "Güvenli Mod", "Havaya gizli zemin kurarak tehlikeden kaçar.", 1, function(state)
    Toggles.SafeMode = state
    
    -- Eğer hile aniden kapatılırsa platformu sil ve karakteri geri indir
    if not state then
        if safePlatform then safePlatform:Destroy() safePlatform = nil end
        if safeIsHiding and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = safePos
        end
        safeIsHiding = false
    end

    while Toggles.SafeMode and task.wait(0.1) do
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart

            local flyingKnifeDanger = false
            for _, v in pairs(Workspace:GetChildren()) do
                if v.Name == "Knife" and v:IsA("BasePart") and v.Velocity.Magnitude > 15 then
                    if (hrp.Position - v.Position).Magnitude < 15 then
                        flyingKnifeDanger = true
                        break
                    end
                end
            end

            local murderer = nil
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    if plr.Backpack:FindFirstChild("Knife") or plr.Character:FindFirstChild("Knife") then
                        murderer = plr
                        break
                    end
                end
            end

            local murdererDanger = false
            local distFromTarget = math.huge

            if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                local measurePos = safeIsHiding and safePos.Position or hrp.Position
                distFromTarget = (measurePos - murderer.Character.HumanoidRootPart.Position).Magnitude
                if distFromTarget < 20 then
                    murdererDanger = true
                end
            end

            if flyingKnifeDanger or murdererDanger then
                if not safeIsHiding then
                    safeIsHiding = true
                    safePos = hrp.CFrame
                    local targetSafeCFrame = hrp.CFrame + Vector3.new(0, 60, 0) -- Çok yukarı çıkıp bariyere takılmamak için 70'den 60'a düşürüldü
                    
                    -- Havada üzerinde durabileceğin görünmez bir zemin oluşturuyoruz
                    if not safePlatform then
                        safePlatform = Instance.new("Part")
                        safePlatform.Size = Vector3.new(30, 1, 30)
                        safePlatform.Position = targetSafeCFrame.Position - Vector3.new(0, 3.5, 0)
                        safePlatform.Anchored = true
                        safePlatform.Transparency = 1 -- Görünmez
                        safePlatform.Parent = Workspace
                    end
                    
                    hrp.CFrame = targetSafeCFrame
                    Notify("TEHLİKE! Güvenli zemine kaçıldı.")
                end
            else
                if safeIsHiding and distFromTarget > 35 and not flyingKnifeDanger then
                    safeIsHiding = false
                    -- Tehlike geçince zemini yok et
                    if safePlatform then safePlatform:Destroy() safePlatform = nil end
                    hrp.CFrame = safePos
                    Notify("Tehlike geçti, geri dönüldü.")
                end
            end
        end)
    end
end)

local realChar, fakeChar, ghostPlatform

CreateToggle(UtilityCard, "Hayalet Görünmezlik", "Gerçek bedeni 1000 stud yukarı gizler.", 2, function(state)
if state then
realChar = LocalPlayer.Character
if realChar and realChar:FindFirstChild("HumanoidRootPart") then
realChar.Archivable = true
fakeChar = realChar:Clone()
fakeChar.Name = "Ghost_" .. LocalPlayer.Name
fakeChar.Parent = Workspace

for _, v in pairs(fakeChar:GetDescendants()) do
if (v:IsA("BasePart") or v:IsA("Decal")) and v.Name ~= "HumanoidRootPart" then
v.Transparency = 0.5
end
end

local realHrp = realChar:FindFirstChild("HumanoidRootPart")

ghostPlatform = Instance.new("Part")
ghostPlatform.Size = Vector3.new(20, 1, 20)
ghostPlatform.Position = realHrp.Position + Vector3.new(0, 1000, 0)
ghostPlatform.Anchored = true
ghostPlatform.Transparency = 1
ghostPlatform.Parent = Workspace

realHrp.CFrame = ghostPlatform.CFrame + Vector3.new(0, 5, 0)

LocalPlayer.Character = fakeChar
Workspace.CurrentCamera.CameraSubject = fakeChar:FindFirstChild("Humanoid")
Notify("Hayalet Modu AÇIK. Bedenin güvende.")
end
else
if realChar and realChar:FindFirstChild("HumanoidRootPart") then
local realHrp = realChar:FindFirstChild("HumanoidRootPart")
if fakeChar and fakeChar:FindFirstChild("HumanoidRootPart") then
realHrp.CFrame = fakeChar.HumanoidRootPart.CFrame
end
LocalPlayer.Character = realChar
Workspace.CurrentCamera.CameraSubject = realChar:FindFirstChild("Humanoid")
end
if fakeChar then fakeChar:Destroy() end
if ghostPlatform then ghostPlatform:Destroy() end
Notify("Hayalet Modu KAPALI. Geri dönüldü.")
end
end)

-- === GÖRSEL SEKMESİ (ESP) ===
local VisualCard = CreateCategoryCard(VisualTab, "Oyuncu İzleme (ESP)")
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "DarkerSH_ESP"
ESPFolder.Parent = CoreGui

local function GetRole(player)
if player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then return "Murderer" end
if player.Backpack:FindFirstChild("Gun") or (player.Character and player.Character:FindFirstChild("Gun")) then return "Sheriff" end
return "Innocent"
end

local function UpdateESP()
for _, v in pairs(ESPFolder:GetChildren()) do v:Destroy() end

for _, plr in pairs(Players:GetPlayers()) do
if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Head") then
local role = GetRole(plr)
local shouldDraw = false
local espColor = Color3.fromRGB(0, 255, 0) 
local roleName = (currentLang == "TR") and "Masum" or "Innocent"

if Toggles.PlayerESP then
shouldDraw = true
if role == "Murderer" then espColor = Color3.fromRGB(255, 0, 0); roleName = (currentLang == "TR") and "Katil" or "Murderer" end
if role == "Sheriff" then espColor = Color3.fromRGB(0, 0, 255); roleName = (currentLang == "TR") and "Şerif" or "Sheriff" end
elseif Toggles.MurdererESP and role == "Murderer" then
shouldDraw = true
espColor = Color3.fromRGB(255, 0, 0)
roleName = (currentLang == "TR") and "Katil" or "Murderer"
elseif Toggles.SheriffESP and role == "Sheriff" then
shouldDraw = true
espColor = Color3.fromRGB(0, 0, 255)
roleName = (currentLang == "TR") and "Şerif" or "Sheriff"
end

if shouldDraw then
-- Vücut Boyama
local Highlight = Instance.new("Highlight")
Highlight.Name = "HL_"..plr.Name
Highlight.Adornee = plr.Character
Highlight.FillColor = espColor
Highlight.OutlineColor = Color3.new(1, 1, 1)
Highlight.FillTransparency = 0.5
Highlight.OutlineTransparency = 0.2
Highlight.Parent = ESPFolder

-- İsim ve Mesafe Yazısı (BillboardGui)
local bgui = Instance.new("BillboardGui")
bgui.Name = "TXT_"..plr.Name
bgui.Adornee = plr.Character.Head
bgui.Size = UDim2.new(0, 200, 0, 50)
bgui.StudsOffset = Vector3.new(0, 2, 0)
bgui.AlwaysOnTop = true
bgui.Parent = ESPFolder

local txt = Instance.new("TextLabel")
txt.Size = UDim2.new(1, 0, 1, 0)
txt.BackgroundTransparency = 1
txt.Text = plr.Name .. "\n[" .. roleName .. "]"
txt.Font = Enum.Font.GothamBold
txt.TextSize = 10
txt.TextColor3 = espColor
txt.TextStrokeTransparency = 0
txt.Parent = bgui
end
end
end
end

RunService.RenderStepped:Connect(function()
if Toggles.PlayerESP or Toggles.MurdererESP or Toggles.SheriffESP then
-- Mesafe güncellemeleri
if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
local myPos = LocalPlayer.Character.HumanoidRootPart.Position
for _, bgui in pairs(ESPFolder:GetChildren()) do
if bgui:IsA("BillboardGui") and bgui.Adornee and bgui.Adornee.Parent then
local targetPlr = Players:GetPlayerFromCharacter(bgui.Adornee.Parent)
if targetPlr then
local dist = math.floor((myPos - bgui.Adornee.Position).Magnitude)
local role = GetRole(targetPlr)
local roleName = role
if currentLang == "TR" then
roleName = (role == "Murderer") and "Katil" or (role == "Sheriff" and "Şerif" or "Masum")
end
bgui.TextLabel.Text = targetPlr.Name .. " [" .. dist .. "m]\n[" .. roleName .. "]"
end
end
end
end
else
for _, v in pairs(ESPFolder:GetChildren()) do v:Destroy() end
end
end)

-- Esp verilerini anlık yenilemek için 1 saniyelik döngü (Rol değişimleri için)
task.spawn(function()
while task.wait(1) do
if Toggles.PlayerESP or Toggles.MurdererESP or Toggles.SheriffESP then
UpdateESP()
end
end
end)

CreateToggle(VisualCard, "Tüm Oyuncular (Player ESP)", "İsim, Mesafe ve Rol Gösterir.", 1, function(state)
Toggles.PlayerESP = state
UpdateESP()
end)
CreateToggle(VisualCard, "Sadece Katil (Murderer ESP)", "Katili ve uzaklığını gösterir.", 0, function(state)
Toggles.MurdererESP = state
UpdateESP()
end)
CreateToggle(VisualCard, "Sadece Şerif (Sheriff ESP)", "Şerifi ve uzaklığını gösterir.", 0, function(state)
Toggles.SheriffESP = state
UpdateESP()
end)
