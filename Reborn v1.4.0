local TeleportCard = CreateCategoryCard(TeleportTab, "Hızlı Işınlanma")

-- Dinamik Harita Takip Sistemi (Aniden Işınlanma Algılayıcı)
local dynamicMapPos = nil
local lastPlayerPositions = {}

task.spawn(function()
    while task.wait(0.5) do
        local inGameCount = 0
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local currentPos = p.Character.HumanoidRootPart.Position
                local lastPos = lastPlayerPositions[p]
                
                -- Oyuncu yarım saniyede 100 stud'dan fazla uzağa gittiyse (ışınlandıysa)
                if lastPos and (currentPos - lastPos).Magnitude > 100 and currentPos.Y > 0 then
                    dynamicMapPos = currentPos -- Gittiği ilk yeri Harita olarak kaydet
                end
                
                -- Lobi yüksekliğinin (yaklaşık 134) epey altında veya üstünde olanları (oyundakileri) say
                if math.abs(currentPos.Y - 134) > 30 then
                    inGameCount = inGameCount + 1
                end
                
                lastPlayerPositions[p] = currentPos
            else
                lastPlayerPositions[p] = nil
            end
        end
        
        -- Eğer haritada kimse kalmadıysa (herkes öldü/lobiye döndüyse) pozisyonu sıfırla
        if inGameCount == 0 then
            dynamicMapPos = nil
        end
    end
end)

CreateButton(TeleportCard, "Lobiye Işınlan", "Bekleme salonuna (Lobby) geri dönersin.", 0, "GİT", function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        -- Yüksekteki bariyerlere takılmamak için Y seviyesi (138'den) 134'e düşürüldü
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(-109, 134, 11)
        Notify("Lobiye ışınlandın.")
    end
end)

CreateButton(TeleportCard, "Haritaya Işınlan", "Oynanan haritanın ortasına gidersin.", 0, "GİT", function()
    if dynamicMapPos and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        -- Haritaya giderken havadan düşmemek ve bariyere takılmamak için +5 offset +1.5 yapıldı
        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(dynamicMapPos.X, dynamicMapPos.Y + 1.5, dynamicMapPos.Z)
        Notify("Haritaya ışınlandın.")
    else
        Notify("Oyun şu an başlamamış veya harita bulunamadı!")
    end
end)

CreateButton(TeleportCard, "Katile Işınlan", "Katilin tam arkasına ışınlanırsın.", 0, "GİT", function()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and GetRole(plr) == "Murderer" and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = plr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 4)
                Notify("Katile ışınlandın!") return
            end
        end
    end
    Notify("Katil bulunamadı.")
end)

CreateButton(TeleportCard, "Şerife Işınlan", "Şerifin tam arkasına ışınlanırsın.", 0, "GİT", function()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and GetRole(plr) == "Sheriff" and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = plr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 4)
                Notify("Şerife ışınlandın!") return
            end
        end
    end
    Notify("Şerif bulunamadı.")
end)
