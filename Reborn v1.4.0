Instance.new("UICorner", CmdExec).CornerRadius = UDim.new(0, 6)
CmdExec.Parent = CmdFrame

-- GERÇEK KOD ÇALIŞTIRMA SİSTEMİ
CmdExec.MouseButton1Click:Connect(function()
    local text = CmdInput.Text
    if text ~= "" then
        local func, err = loadstring(text)
        if func then
            task.spawn(func)
            local msg = (currentLang == "TR") and "Komut çalıştırıldı: " or "Executed: "
            Notify(msg .. text)
        else
            local msg = (currentLang == "TR") and "Hata: " or "Error: "
            Notify(msg .. tostring(err))
        end
        CmdInput.Text = ""
    end
end)
