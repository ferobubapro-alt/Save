end

local function CreateQuickWidget(name, toggleCallback)
if FloatingWidgets[name] then return end

local Widget = Instance.new("Frame")
Widget.Size = UDim2.new(0, 120, 0, 40)
Widget.Position = UDim2.new(0.8, 0, 0.5, 0)
Widget.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
Widget.ZIndex = 100
Widget.Active = true
Widget.Parent = ScreenGui
Instance.new("UICorner", Widget).CornerRadius = UDim.new(0, 8)

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(255, 255, 255)
UIStroke.Transparency = 0.6
UIStroke.Thickness = 1
UIStroke.Parent = Widget

local Btn = Instance.new("TextButton")
Btn.Size = UDim2.new(1, 0, 1, 0)
Btn.BackgroundTransparency = 1
Btn.Text = name
Btn.Font = Enum.Font.GothamBold
Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
Btn.TextSize = 12
Btn.TextWrapped = true
Btn.ZIndex = 101
Btn.Parent = Widget

local LockBtn = Instance.new("TextButton")
LockBtn.Size = UDim2.new(0, 25, 0, 25)
LockBtn.Position = UDim2.new(1, -30, 0, -10)
LockBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
LockBtn.Text = "🔓"
LockBtn.ZIndex = 105
LockBtn.Visible = false
Instance.new("UICorner", LockBtn).CornerRadius = UDim.new(1, 0)
LockBtn.Parent = Widget

local ResizeHandle = nil
pcall(function() 
ResizeHandle = MakeResizable(Widget, 100, 40)
ResizeHandle.Visible = false 
end)

MakeDraggable(Widget, Btn)
FloatingWidgets[name] = Widget

local isLocked = false
local editMode = false

LockBtn.MouseButton1Click:Connect(function()
isLocked = not isLocked
LockBtn.Text = isLocked and "🔒" or "🔓"
LockBtn.BackgroundColor3 = isLocked and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
Widget.Active = not isLocked
Notify(name .. (isLocked and " Widget Kitlendi!" or " Widget Kilidi Açıldı!"))
end)

local wIsPressed = false
local wFired = false
Btn.MouseButton1Down:Connect(function()
if isLocked then return end
wIsPressed = true; wFired = false
task.delay(0.5, function()
if wIsPressed and not wFired then
wFired = true
editMode = not editMode
LockBtn.Visible = editMode
if ResizeHandle then ResizeHandle.Visible = editMode end

if editMode then
TweenService:Create(Widget, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -Widget.AbsoluteSize.X/2, 0.5, -Widget.AbsoluteSize.Y/2)}):Play()
UIStroke.Color = Color3.fromRGB(138, 43, 226)
UIStroke.Transparency = 0
Notify("Düzenleme Modu: Boyutu ayarlayabilir veya kitleyebilirsiniz.")
else
UIStroke.Color = Color3.fromRGB(255, 255, 255)
UIStroke.Transparency = 0.6
end
end
end)
end)

Btn.MouseButton1Up:Connect(function()
wIsPressed = false
if not wFired and not editMode then 
toggleCallback()
end
end)
Btn.MouseLeave:Connect(function() wIsPressed = false end)
end

local function RemoveQuickWidget(name)
if FloatingWidgets[name] then
FloatingWidgets[name]:Destroy()
FloatingWidgets[name] = nil
Notify(name .. " Hızlı Butonu Kaldırıldı.")
end
end

local function CreateToggle(parentContainer, name, description, minTier, callback)
    local RowFrame = Instance.new("Frame")
    RowFrame.Size = UDim2.new(1, -5, 0, 45)
    RowFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    RowFrame.ZIndex = 4
    RowFrame.Parent = parentContainer
    Instance.new("UICorner", RowFrame).CornerRadius = UDim.new(0, 6)
local ClickArea = Instance.new("TextButton")
    ClickArea.Size = UDim2.new(1, 0, 1, 0)
    ClickArea.BackgroundTransparency = 1
    ClickArea.Text = ""
    ClickArea.ZIndex = 15 
    ClickArea.Parent = RowFrame

    -- KABA YAZI YERİNE ANİMASYONLU NOKTA (DOT) SİSTEMİ
  local TierDot = Instance.new("Frame")
    TierDot.Size = UDim2.new(0, 8, 0, 8)
    TierDot.Position = UDim2.new(0, 10, 0, 9) -- YENİ: Tam yazının hizasına sabitlendi
    TierDot.ZIndex = 5
    Instance.new("UICorner", TierDot).CornerRadius = UDim.new(1, 0)
    TierDot.Parent = RowFrame

    if minTier == 2 then
        TierDot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        local dotGrad = Instance.new("UIGradient")
        dotGrad.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(138, 43, 226)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(40, 10, 60)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(138, 43, 226))
        }
        dotGrad.Parent = TierDot
        task.spawn(function()
            while task.wait(0.02) do
                if dotGrad.Parent then dotGrad.Rotation = (dotGrad.Rotation + 5) % 360 else break end
            end
        end)
    elseif minTier == 1 then
        TierDot.BackgroundColor3 = Color3.fromRGB(50, 150, 255)
    else
        TierDot.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    end

    local TitleLbl = Instance.new("TextLabel")
    TitleLbl.Name = "TitleLbl"
    TitleLbl.Size = UDim2.new(1, -100, 0, 20)
    TitleLbl.Position = UDim2.new(0, 25, 0, 3) -- Yazı, noktaya daha yakın olması için 55'ten 25'e çekildi
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = name
    TitleLbl.Font = Enum.Font.GothamBold
    TitleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLbl.TextSize = 12
    TitleLbl.TextWrapped = true
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
    TitleLbl.ZIndex = 5
    TitleLbl.Parent = RowFrame

   local DescLbl = Instance.new("TextLabel")
    DescLbl.Name = "DescLbl"
    DescLbl.Size = UDim2.new(1, -60, 0, 15) -- YENİ: Butona çarpmasını önler
    DescLbl.Position = UDim2.new(0, 10, 0, 22)
    DescLbl.BackgroundTransparency = 1
    DescLbl.Text = description
    DescLbl.Font = Enum.Font.Gotham
    DescLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
    DescLbl.TextScaled = true -- YENİ: Ekran küçülünce yazıyı dinamik küçültür
    DescLbl.TextWrapped = true
    DescLbl.TextXAlignment = Enum.TextXAlignment.Left
    DescLbl.ZIndex = 5
    DescLbl.Parent = RowFrame

    local ToggleBtn = Instance.new("Frame")
    ToggleBtn.Size = UDim2.new(0, 36, 0, 18)
    ToggleBtn.Position = UDim2.new(1, -45, 0.5, -9)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    ToggleBtn.ZIndex = 5
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)
    ToggleBtn.Parent = RowFrame

    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.new(0, 14, 0, 14)
    Circle.Position = UDim2.new(0, 2, 0, 2)
    Circle.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    Circle.ZIndex = 6
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)
    Circle.Parent = ToggleBtn

    local toggled = false

    local function FireToggle()
        if UserTierValue < 0 then Notify("Önce Key giriniz!"); return end
        if UserTierValue < minTier then Notify("Bu özellik " .. (minTier == 1 and "LITE" or "PRO") .. " yetkisi gerektirir!"); return end

        toggled = not toggled
        if toggled then
            TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(138, 43, 226)}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(1, -16, 0, 2), BackgroundColor3 = Color3.fromRGB(255,255,255)}):Play()
        else
            TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 50)}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0, 2), BackgroundColor3 = Color3.fromRGB(200,200,200)}):Play()
        end
        pcall(function() callback(toggled) end)
    end

    local isPressed = false; local longPressFired = false
    ClickArea.MouseButton1Down:Connect(function()
        isPressed = true; longPressFired = false
        task.delay(0.5, function()
            if isPressed and not longPressFired then
                longPressFired = true
                if FloatingWidgets[name] then RemoveQuickWidget(name) else CreateQuickWidget(name, FireToggle); Notify(name .. " Hızlı Buton Eklendi!") end
            end
        end)
    end)
   ClickArea.MouseButton1Up:Connect(function() isPressed = false; if not longPressFired then FireToggle() end end)
    ClickArea.MouseLeave:Connect(function() isPressed = false end)
    
    table.insert(FeatureElements, {UI = RowFrame, Tier = minTier}) -- YENİ EKLENDİ
end

