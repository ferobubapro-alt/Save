local Tabs = {}
local function CreateTab(name, isDefault, useGrid)
local TabBtn = Instance.new("TextButton")
TabBtn.Size = UDim2.new(1, -5, 0, 35)
TabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
TabBtn.Text = name
TabBtn.Font = Enum.Font.GothamBold
TabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
TabBtn.TextSize = 13
TabBtn.ZIndex = 3
Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 8)
TabBtn.Parent = TabContainer

local TabPage = Instance.new("ScrollingFrame")
TabPage.Size = UDim2.new(1, 0, 1, 0)
TabPage.BackgroundTransparency = 1
TabPage.BorderSizePixel = 0
TabPage.ScrollBarThickness = 4
TabPage.Visible = isDefault
TabPage.ZIndex = 2
TabPage.Parent = ContentContainer

if useGrid then
local PageLayout = Instance.new("UIGridLayout")
PageLayout.CellSize = UDim2.new(0, 290, 0, 230)
PageLayout.CellPadding = UDim2.new(0, 10, 0, 10)
PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
PageLayout.Parent = TabPage

PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
TabPage.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 20)
end)
end

Tabs[name] = {Button = TabBtn, Page = TabPage}

TabBtn.MouseButton1Click:Connect(function()
    for tName, tabData in pairs(Tabs) do
        if tName == name then
            if not tabData.Page.Visible then
                tabData.Page.Position = UDim2.new(-1, 0, 0, 0)
                tabData.Page.Visible = true
                TweenService:Create(tabData.Page, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
            end
            
            if UserTierValue == 2 then
                -- PRO İÇİN PARLAYAN YAZI EFEKTİ (Arka plan şeffaf, Yazı gradient)
                tabData.Button.BackgroundTransparency = 1
                if tabData.Button:FindFirstChild("TabWaveGradient") then
                    tabData.Button.TabWaveGradient.Enabled = true
                end
            else
                tabData.Button.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
                tabData.Button.BackgroundTransparency = 0
                tabData.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        else
            tabData.Page.Visible = false
            if UserTierValue == 2 then
                -- PRO İÇİN PASİF DURUM
                tabData.Button.BackgroundTransparency = 1
                if tabData.Button:FindFirstChild("TabWaveGradient") then
                    tabData.Button.TabWaveGradient.Enabled = false
                end
                tabData.Button.TextColor3 = Color3.fromRGB(150, 150, 160)
            else
                tabData.Button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
                tabData.Button.BackgroundTransparency = 0
                tabData.Button.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end
    end
end)

if isDefault then
    TabBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
    TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
end

return TabPage
end
