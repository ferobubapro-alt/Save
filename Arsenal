local Tabs = {}

local function SwitchTab(tabName)
	for tName, tabData in pairs(Tabs) do
		if tName == tabName then
			tabData.Page.Visible = true
			tabData.Button.BackgroundTransparency = 0
			tabData.Indicator.Visible = true
			tabData.Icon.ImageColor3 = Colors.AccentGold
			tabData.Text.TextColor3 = Colors.AccentGold
		else
			tabData.Page.Visible = false
			tabData.Button.BackgroundTransparency = 1
			tabData.Indicator.Visible = false
			tabData.Icon.ImageColor3 = Colors.TextDim
			tabData.Text.TextColor3 = Colors.TextDim
		end
	end
end

