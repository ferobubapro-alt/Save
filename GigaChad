local ColorDarkGrey = Color3.fromRGB(20, 20, 20)
local ColorLightGrey = Color3.fromRGB(45, 45, 45)
local ColorGreen = Color3.fromRGB(46, 204, 113)
local ColorWhite = Color3.fromRGB(255, 255, 255)

local function applyWaveGradient(parent)
	parent.BackgroundColor3 = ColorWhite 
	
	local gradient = create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, ColorDarkGrey),
			ColorSequenceKeypoint.new(0.5, ColorLightGrey),
			ColorSequenceKeypoint.new(1, ColorDarkGrey)
		}),
		Rotation = 45,
		Parent = parent
	})
	
	RunService.RenderStepped:Connect(function()
		local time = tick() * 0.4
		gradient.Offset = Vector2.new(math.sin(time), math.cos(time)) * 0.3
	end)
end

local function applyStroke(parent)
	create("UIStroke", {
		Color = Color3.fromRGB(80, 80, 80),
		Thickness = 1,
		Parent = parent
	})
end

