	combatGui.Parent = playerGui

	-- ÜST: ATTACK (Şimdilik Boş)
	createDropdown(combatGui, "ATTACK", UDim2.new(0.5, 0, 0, 10), Vector2.new(0.5, 0), UDim2.new(0, 200, 0, 40), {}, "Attack")

	-- SOL: DRAGON SLAYER (Stances)
	if STANCES[currentStyle] then
		createDropdown(combatGui, "DRAGON SLAYER", UDim2.new(0, 10, 0.5, -100), Vector2.new(0, 0.5), UDim2.new(0, 180, 0, 40), STANCES[currentStyle], "Stance")
	end

	-- SAĞ: VOICE LINES
	if VOICES[currentStyle] then
		createDropdown(combatGui, "VOICE LINES", UDim2.new(1, -10, 0.5, -100), Vector2.new(1, 0.5), UDim2.new(0, 180, 0, 40), VOICES[currentStyle], "Voice")
	end
	
	-- SAĞ ALT: ABILITIES (Şimdilik sadece Berserker için Smell Them)
	if ABILITIES[currentStyle] then
		createDropdown(combatGui, "ABILITIES", UDim2.new(1, -10, 0.5, 80), Vector2.new(1, 0.5), UDim2.new(0, 180, 0, 40), ABILITIES[currentStyle], "Ability")
	end
end

