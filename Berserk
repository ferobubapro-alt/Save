	makeCharBtn("GUTS", 95, "Guts")
end

--============================================================
-- UPDATE (DÖNGÜ)
--============================================================

local function update()
	if not humanoid or humanoid.Health <= 0 then return end
	
	-- Roblox'un varsayılan animasyonlarını sustur
	stopDefaultAnimations()

	local moving = humanoid.MoveDirection.Magnitude > 0.05
	local state = humanoid:GetState()
	local airborne = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown

	--========================================================
	-- 1. DURUM: Hareketsiz (Idle)
	--========================================================
	if not moving and not airborne then
		if runTrack and runTrack.IsPlaying then runTrack:Stop(0.12) end
		
		-- Eğer saldırı animasyonu çalmıyorsa Idle oynat
		if not attackTrack or not attackTrack.IsPlaying then
			if not idleTrack or not idleTrack.IsPlaying then 
				playIdle() 
			end
		end
		return
	end

	--========================================================
	-- 2. DURUM: Hareket Halinde (Run)
	--========================================================
	if moving and not airborne then
		if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(0.12) end
		
		-- Eğer saldırı animasyonu çalmıyorsa koşma animasyonunu oynat
		if not attackTrack or not attackTrack.IsPlaying then
			if RUN_ENABLED[currentStyle] then
				if not runTrack then createRun() end
				if runTrack and not runTrack.IsPlaying then runTrack:Play(0.12, 1, 1) end
			end
		end
		return
	end

	--========================================================
	-- 3. DURUM: Havada (Airborne)
	--========================================================
	if airborne then
		if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(0.1) end
		if runTrack and runTrack.IsPlaying then runTrack:Stop(0.1) end
	end
end

--============================================================
-- BAŞLATMA VE KARAKTER BAĞLANTILARI
--============================================================

local function loadCharacter(char)
	character = char
	humanoid = character:WaitForChild("Humanoid")
	animator = humanoid:WaitForChild("Animator")
	
	-- Can değiştiğinde Idle'ı kontrol et (Yaralı animasyonuna geçiş için)
	humanoid:GetPropertyChangedSignal("Health"):Connect(function()
		if isIdle() and not currentStanceId then playIdle() end
	end)
	
	-- Menüyü oluştur
	createSelectionGUI()
end

-- Script başladığında karakter zaten varsa yükle
if player.Character then 
	loadCharacter(player.Character) 
end

-- Karakter her doğduğunda / resetlendiğinde yeniden yükle
player.CharacterAdded:Connect(loadCharacter)

-- Her karede (frame) güncelleme döngüsünü çalıştır
RunService.RenderStepped:Connect(update)
