	if idleTrack then pcall(function() idleTrack:Stop(); idleTrack:Destroy() end); idleTrack = nil end
	if runTrack then pcall(function() runTrack:Stop(); runTrack:Destroy() end); runTrack = nil end
	if attackTrack then pcall(function() attackTrack:Stop(); attackTrack:Destroy() end); attackTrack = nil end
	
	if gui then gui:Destroy(); gui = nil end
	if vfxGui then vfxGui:Destroy(); vfxGui = nil end
	if combatGui then combatGui:Destroy(); combatGui = nil end
end

