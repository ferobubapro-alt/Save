local function clearVisuals()
	if idleConnection then idleConnection:Disconnect(); idleConnection = nil end
	if idleTrack then pcall(function() idleTrack:Stop(CROSSFADE_TIME); idleTrack:Destroy() end); idleTrack = nil end
	if runTrack then pcall(function() runTrack:Stop(CROSSFADE_TIME); runTrack:Destroy() end); runTrack = nil end
	
	if gui then gui:Destroy(); gui = nil end
	if vfxGui then vfxGui:Destroy(); vfxGui = nil end
	if combatGui then combatGui:Destroy(); combatGui = nil end
	
	-- Işık ve Hız sıfırlama
	if humanoid then humanoid.WalkSpeed = 16 end
	if Lighting:FindFirstChild("BerserkCC") then Lighting.BerserkCC:Destroy() end
end

