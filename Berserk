--============================================================
-- BERSERKER YETENEKLERİ
--============================================================

local function activateSmellThem()
	if smellThemCooldown then return end
	smellThemCooldown = true
	
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
			local targetChar = plr.Character
			
			local hl = Instance.new("Highlight")
			hl.Name = "SmellThemHL"
			hl.FillColor = Color3.fromRGB(150, 0, 0)
			hl.OutlineColor = Color3.fromRGB(255, 0, 0)
			hl.FillTransparency = 1
			hl.OutlineTransparency = 1
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Parent = targetChar
			
			-- Smooth Belirme
			TweenService:Create(hl, TweenInfo.new(0.5, Enum.EasingStyle.Sine), {FillTransparency = 0.4, OutlineTransparency = 0}):Play()
			
			-- 5 Saniye Sonra Kaybolma
			task.delay(5, function()
				if hl and hl.Parent then
					local outTween = TweenService:Create(hl, TweenInfo.new(0.5, Enum.EasingStyle.Sine), {FillTransparency = 1, OutlineTransparency = 1})
					outTween:Play()
					outTween.Completed:Connect(function() hl:Destroy() end)
				end
			end)
		end
	end
	
	task.delay(6, function() smellThemCooldown = false end)
end

--============================================================
-- SES & ANİMASYON FONKSİYONLARI
--============================================================

local function playVoice(id)
	if not character or not character:FindFirstChild("Head") then return end
	if currentVoice then currentVoice:Destroy() end
	
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. id
	sound.Volume = 2
	sound.Parent = character.Head
	sound:Play()
	currentVoice = sound
	
	sound.Ended:Connect(function()
		if sound == currentVoice then currentVoice = nil end
		sound:Destroy()
	end)
end

local function stopDefaultAnimations()
	if not animator then return end
	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		if track ~= idleTrack and track ~= runTrack then
			local anim = track.Animation
			if anim then
				local name = string.lower(anim.Name or "")
				if name:find("idle") or name:find("walk") or name:find("run") then
					pcall(function() track:Stop(CROSSFADE_TIME) end)
				end
			end
		end
	end
end

local function isIdle()
	if not humanoid or humanoid.Health <= 0 then return false end
	local state = humanoid:GetState()
	local moving = humanoid.MoveDirection.Magnitude > 0.05
	if moving then return false end
	if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall then return false end
	return true
end

local function playIdle()
	if not animator or not currentStyle or not isIdle() then return end

	if idleTrack then
		pcall(function() idleTrack:Stop(CROSSFADE_TIME); idleTrack:Destroy() end)
		idleTrack = nil
	end

	local animIdToPlay = nil

	if currentStanceId then
		animIdToPlay = currentStanceId
	elseif currentStyle == "Guts" and humanoid.Health <= (humanoid.MaxHealth * 0.3) then
		animIdToPlay = GUTS_INJURED_IDLE
	else
		local list = IDLE_ANIMS[currentStyle]
		if list then
			local totalWeight = 0
			for _, data in ipairs(list) do totalWeight += data.Weight end
			local rnd = math.random(1, totalWeight)
			local counter = 0
			for _, data in ipairs(list) do
				counter += data.Weight
				if rnd <= counter then animIdToPlay = data.Id; break end
			end
		end
	end

	if not animIdToPlay then return end

	local animation = Instance.new("Animation")
	animation.AnimationId = animIdToPlay
	animation.Name = "CustomIdle"
	
	local success, track = pcall(function() return animator:LoadAnimation(animation) end)
	animation:Destroy()
	
	if success and track then
		idleTrack = track
		idleTrack.Priority = Enum.AnimationPriority.Action4
		idleTrack.Looped = not (currentStyle == "Guts" and not currentStanceId) 
		
		idleConnection = idleTrack.Ended:Connect(function()
			if idleTrack == track and humanoid and humanoid.Health > 0 and isIdle() then
				task.wait(0.08)
				if isIdle() then playIdle() end
			end
		end)
		track:Play(CROSSFADE_TIME, 1, 1)
	end
end

local function createRun()
	if not animator or not currentStyle or not RUN_ENABLED[currentStyle] then return end
	if runTrack then pcall(function() runTrack:Stop(CROSSFADE_TIME); runTrack:Destroy() end) end

	local animation = Instance.new("Animation")
	animation.AnimationId = RUN_ANIM
	local success, track = pcall(function() return animator:LoadAnimation(animation) end)
	animation:Destroy()
	
	if success and track then
		runTrack = track
		runTrack.Priority = Enum.AnimationPriority.Action3
		runTrack.Looped = true
	end
end

