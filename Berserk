-- GUI: COMBAT HUD
--============================================================

local function createDropdown(parent, titleText, udimPos, anchor, sizeVec, items, type)
	local container = Instance.new("Frame")
	container.Size = sizeVec
	container.Position = udimPos
	container.AnchorPoint = anchor
	container.BackgroundTransparency = 1
	container.Parent = parent

	local mainBtn = Instance.new("TextButton")
	mainBtn.Size = UDim2.new(1, 0, 0, 40)
	mainBtn.BackgroundColor3 = COLOR_BG
	mainBtn.BorderColor3 = COLOR_BORDER
	mainBtn.BorderSizePixel = 2
	mainBtn.Font = FONT_THEME
	mainBtn.Text = titleText
	mainBtn.TextColor3 = Color3.fromRGB(255, 0, 0)
	mainBtn.TextSize = 22
	mainBtn.Parent = container

	local listFrame = Instance.new("Frame")
	listFrame.Size = UDim2.new(1, 0, 0, 0)
	listFrame.Position = UDim2.new(0, 0, 0, 45)
	listFrame.BackgroundColor3 = COLOR_BG
	listFrame.BorderColor3 = COLOR_BORDER
	listFrame.BorderSizePixel = 2
	listFrame.ClipsDescendants = true
	listFrame.Parent = container

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 2)
	listLayout.Parent = listFrame

	local isOpen = false
	local stanceButtons = {}

	mainBtn.MouseButton1Click:Connect(function()
		isOpen = not isOpen
		local targetSize = isOpen and UDim2.new(1, 0, 0, #items * 35) or UDim2.new(1, 0, 0, 0)
		TweenService:Create(listFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize}):Play()
	end)

	for _, item in ipairs(items) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 33)
		btn.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
		btn.BorderSizePixel = 0
		btn.Font = FONT_THEME
		btn.Text = item.Name
		btn.TextColor3 = COLOR_TEXT
		btn.TextSize = 18
		btn.Parent = listFrame

		if type == "Stance" then table.insert(stanceButtons, {btn = btn, id = item.Id}) end

		btn.MouseButton1Click:Connect(function()
			if type == "Voice" then
				playVoice(item.Id)
			elseif type == "Attack" then
				playAttack(item.Id)
			elseif type == "Stance" then
				if currentStanceId == item.Id then
					currentStanceId = nil
				else
					currentStanceId = item.Id
				end
				
				for _, d in ipairs(stanceButtons) do
					if d.id == currentStanceId then
						d.btn.Text = "SEÇİLİ"
						d.btn.TextColor3 = Color3.fromRGB(0, 0, 0)
						d.btn.BackgroundColor3 = COLOR_SELECTED
					else
						d.btn.Text = item.Name
						for _, st in ipairs(items) do if st.Id == d.id then d.btn.Text = st.Name end end
						d.btn.TextColor3 = COLOR_TEXT
						d.btn.BackgroundColor3 = Color3.fromRGB(20, 0, 0)
					end
				end
				playIdle()
			end
		end)
	end
end

