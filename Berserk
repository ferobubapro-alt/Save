			if style == "Berserker" then applyBerserkerEffects() end
			
			task.wait(0.1)
			if animator then
				createRun()
				if isIdle() then playIdle() end
			end
			loadCombatGUI()
		end)
	end

	makeCharBtn("BERSERKER", 50, "Berserker")
	makeCharBtn("GUTS", 95, "Guts")
end

--============================================================
-- UPDATE / KARAKTER YÖNETİMİ
--============================================================

local function update()
	if not humanoid or humanoid.Health <= 0 then return end
	stopDefaultAnimations()

	local moving = humanoid.MoveDirection.Magnitude > 0.05
	local state = humanoid:GetState()
	local airborne = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown

	if not moving and not airborne then
		if runTrack and runTrack.IsPlaying then runTrack:Stop(CROSSFADE_TIME) end
		if not idleTrack or not idleTrack.IsPlaying then playIdle() end
		return
	end

	if moving and not airborne then
		if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(CROSSFADE_TIME) end
		if RUN_ENABLED[currentStyle] then
			if not runTrack then createRun() end
			if runTrack and not runTrack.IsPlaying then runTrack:Play(CROSSFADE_TIME, 1, 1) end
		end
		return
	end

	if airborne then
		if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(CROSSFADE_TIME) end
		if runTrack and runTrack.IsPlaying then runTrack:Stop(CROSSFADE_TIME) end
	end
end

local function loadCharacter(char)
	character = char
	humanoid = character:WaitForChild("Humanoid")
	animator = humanoid:WaitForChild("Animator")
	
	humanoid:GetPropertyChangedSignal("Health"):Connect(function()
		if isIdle() and not currentStanceId then playIdle() end
	end)
	
	createSelectionGUI()
end

if player.Character then loadCharacter(player.Character) end
player.CharacterAdded:Connect(loadCharacter)
RunService.RenderStepped:Connect(update)
