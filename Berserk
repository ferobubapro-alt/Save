	if combatGui then combatGui:Destroy() end
	combatGui = Instance.new("ScreenGui")
	combatGui.Name = "BerserkCombatUI"
	combatGui.ResetOnSpawn = false
	combatGui.Parent = playerGui

	if ATTACKS[currentStyle] then
		createDropdown(combatGui, "ATTACK", UDim2.new(0.5, 0, 0, 10), Vector2.new(0.5, 0), UDim2.new(0, 200, 0, 40), ATTACKS[currentStyle], "Attack")
	end

	if STANCES[currentStyle] then
		createDropdown(combatGui, "DRAGON SLAYER", UDim2.new(0, 10, 0.5, -100), Vector2.new(0, 0.5), UDim2.new(0, 180, 0, 40), STANCES[currentStyle], "Stance")
	end

	if VOICES[currentStyle] then
		createDropdown(combatGui, "VOICE LINES", UDim2.new(1, -10, 0.5, -100), Vector2.new(1, 0.5), UDim2.new(0, 180, 0, 40), VOICES[currentStyle], "Voice")
	end
end

