}
local savedPositions = {}

local isFlingingAll = false
local function ExecuteFling(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return end
    local char = LocalPlayer.Character
    local tChar = targetPlayer.Character
    if char and tChar and char:FindFirstChild("HumanoidRootPart") and tChar:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local tHrp = tChar.HumanoidRootPart
        local oldPos = hrp.CFrame
        local bav = Instance.new("BodyAngularVelocity")
        bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bav.AngularVelocity = Vector3.new(10000, 10000, 10000) * (CombatSettings.FlingPower / 100)
        bav.Parent = hrp
        local startTime = tick()
        local flingConn
        flingConn = RunService.Heartbeat:Connect(function()
            if tChar and tChar:FindFirstChild("HumanoidRootPart") and tick() - startTime < 1.0 then
                hrp.CFrame = tHrp.CFrame * CFrame.new(math.random(-1,1), math.random(-1,1), math.random(-1,1))
                hrp.Velocity = Vector3.new(0, 15000, 0)
            else
                flingConn:Disconnect()
                bav:Destroy()
                hrp.CFrame = oldPos
                hrp.Velocity = Vector3.new(0,0,0)
            end
        end)
        repeat task.wait(0.1) until not flingConn.Connected
    end
end

