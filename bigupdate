                            end
                        end
                    end
                end
            end
            if not locked and CrosshairContainer.Visible then CrosshairContainer.Visible = false end
        end)
    else
        if AimbotConnection then AimbotConnection:Disconnect() AimbotConnection = nil end
        CrosshairContainer.Visible = false
    end
end)
