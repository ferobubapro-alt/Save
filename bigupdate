local safeIsHiding = false
local safePos = nil
local safePlatform = nil -- Havada üzerinde yürüyeceğin zemin

CreateToggle(UtilityCard, "Güvenli Mod", "Havaya gizli zemin kurarak tehlikeden kaçar.", 1, function(state)
    Toggles.SafeMode = state
    
    -- Eğer hile aniden kapatılırsa platformu sil ve karakteri geri indir
    if not state then
        if safePlatform then safePlatform:Destroy() safePlatform = nil end
        if safeIsHiding and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = safePos
        end
        safeIsHiding = false
    end

    while Toggles.SafeMode and task.wait(0.1) do
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart

            local flyingKnifeDanger = false
            for _, v in pairs(Workspace:GetChildren()) do
                if v.Name == "Knife" and v:IsA("BasePart") and v.Velocity.Magnitude > 15 then
                    if (hrp.Position - v.Position).Magnitude < 15 then
                        flyingKnifeDanger = true
                        break
                    end
                end
            end

            local murderer = nil
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    if plr.Backpack:FindFirstChild("Knife") or plr.Character:FindFirstChild("Knife") then
                        murderer = plr
                        break
                    end
                end
            end

            local murdererDanger = false
            local distFromTarget = math.huge

            if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                local measurePos = safeIsHiding and safePos.Position or hrp.Position
                distFromTarget = (measurePos - murderer.Character.HumanoidRootPart.Position).Magnitude
                if distFromTarget < 20 then
                    murdererDanger = true
                end
            end

            if flyingKnifeDanger or murdererDanger then
                if not safeIsHiding then
                    safeIsHiding = true
                    safePos = hrp.CFrame
                    local targetSafeCFrame = hrp.CFrame + Vector3.new(0, 60, 0) -- Çok yukarı çıkıp bariyere takılmamak için 70'den 60'a düşürüldü
                    
                    -- Havada üzerinde durabileceğin görünmez bir zemin oluşturuyoruz
                    if not safePlatform then
                        safePlatform = Instance.new("Part")
                        safePlatform.Size = Vector3.new(30, 1, 30)
                        safePlatform.Position = targetSafeCFrame.Position - Vector3.new(0, 3.5, 0)
                        safePlatform.Anchored = true
                        safePlatform.Transparency = 1 -- Görünmez
                        safePlatform.Parent = Workspace
                    end
                    
                    hrp.CFrame = targetSafeCFrame
                    Notify("TEHLİKE! Güvenli zemine kaçıldı.")
                end
            else
                if safeIsHiding and distFromTarget > 35 and not flyingKnifeDanger then
                    safeIsHiding = false
                    -- Tehlike geçince zemini yok et
                    if safePlatform then safePlatform:Destroy() safePlatform = nil end
                    hrp.CFrame = safePos
                    Notify("Tehlike geçti, geri dönüldü.")
                end
            end
        end)
    end
end)

