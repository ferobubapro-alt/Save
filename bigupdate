local AimbotConnection
local AimbotSmoothness = 0.35 -- Hızlı ve mobil joystiği dondurmayan pürüzsüz kilitlenme

CreateToggle(CombatCard, "Katili Vur (Aimbot)", "Katil ekrana girdiği an kilitlenir ve Crosshair açılır.", 2, function(state)
    Toggles.ShootMurderer = state
    local cam = Workspace.CurrentCamera

    if state then
        Notify("Aimbot Aktif: Katil görüş alanına girdiği an kilitlenecek.")
        
        AimbotConnection = RunService.RenderStepped:Connect(function()
            if not Toggles.ShootMurderer then return end
            
            local murderer = nil
            
            -- Katili Bul (Envanterinde veya karakterinde Knife olan kişi)
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and (plr.Backpack:FindFirstChild("Knife") or plr.Character:FindFirstChild("Knife")) then
                    local hum = plr.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        murderer = plr
                        break
                    end
                end
            end

            local locked = false

            if murderer and murderer.Character and murderer.Character:FindFirstChild("Head") then
                local targetPart = murderer.Character.Head
                local vector, onScreen = cam:WorldToViewportPoint(targetPart.Position)

                -- Sadece katil görüş açısındaysa işlem yap
                if onScreen then
                    local rayParams = RaycastParams.new()
                    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, murderer.Character}
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude

                    local raycastResult = Workspace:Raycast(cam.CFrame.Position, (targetPart.Position - cam.CFrame.Position).Unit * 500, rayParams)

                    -- Arada duvar yoksa (doğrudan görüyorsan) pürüzsüzce kilitlen
                    if not raycastResult then 
                        locked = true
                        local targetCFrame = CFrame.lookAt(cam.CFrame.Position, targetPart.Position)
                        cam.CFrame = cam.CFrame:Lerp(targetCFrame, AimbotSmoothness)
                        
                        -- Kilitlendiği an Crosshair'i animasyonlu şekilde (Pop-up) ekrana getir
                        if not CrosshairContainer.Visible then
                            CrosshairContainer.Visible = true
                            OuterRing.Size = UDim2.new(0, 60, 0, 60)
                            OuterRing.Position = UDim2.new(0.5, -30, 0.5, -30)
                            OuterRing.ImageTransparency = 1
                            
                            TweenService:Create(OuterRing, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                                Size = UDim2.new(0, 40, 0, 40),
                                Position = UDim2.new(0.5, -20, 0.5, -20),
                                ImageTransparency = 0
                            }):Play()
                        end
                    end
                end
            end
            
            -- Eğer hedef öldüyse, duvarın arkasına geçittiyse veya ekrandan çıktıysa crosshair'i anında gizle
            if not locked and CrosshairContainer.Visible then
                CrosshairContainer.Visible = false
            end
        end)
    else
        if AimbotConnection then 
            AimbotConnection:Disconnect() 
            AimbotConnection = nil 
        end
        CrosshairContainer.Visible = false
        Notify("Aimbot Kapatıldı.")
    end
end)
