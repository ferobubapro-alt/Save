local QCFlyLoop, QCFlyBV, QCFlyBG
CreateQCToggle("Fly", function(state)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChild("Humanoid")
    
    if state then
        if hum then hum.PlatformStand = true end
        QCFlyBV = Instance.new("BodyVelocity", hrp)
        QCFlyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        QCFlyBG = Instance.new("BodyGyro", hrp)
        QCFlyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        QCFlyBG.P = 9e4
        
        QCFlyLoop = RunService.RenderStepped:Connect(function()
            local cam = Workspace.CurrentCamera
            local moveDir = hum.MoveDirection
            
            -- MOBİL JOYSTICK VE KAMERA UYUMLU UÇUŞ
            if moveDir.Magnitude > 0 then
                local flatLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z).Unit
                local flatRight = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z).Unit
                local forwardInput = flatLook:Dot(moveDir)
                local rightInput = flatRight:Dot(moveDir)
                local moveVector = (cam.CFrame.LookVector * forwardInput) + (cam.CFrame.RightVector * rightInput)
                QCFlyBV.Velocity = moveVector * 50
            else
                QCFlyBV.Velocity = Vector3.new(0, 0, 0)
            end
            QCFlyBG.CFrame = cam.CFrame
        end)
    else
        if hum then hum.PlatformStand = false end
        if QCFlyLoop then QCFlyLoop:Disconnect() QCFlyLoop = nil end
        if QCFlyBV then QCFlyBV:Destroy() end
        if QCFlyBG then QCFlyBG:Destroy() end
    end
end)

