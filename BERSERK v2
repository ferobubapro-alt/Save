local function spawnCursedSpirit()
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local root = character.HumanoidRootPart
	
	local spirit = Instance.new("Part")
	spirit.Size = Vector3.new(2, 4, 2)
	spirit.Color = Color3.fromRGB(15, 0, 25)
	spirit.Material = Enum.Material.Neon
	spirit.Transparency = 0.4
	spirit.Anchored = true
	spirit.CanCollide = false
	
	local angle = math.random() * math.pi * 2
	local offset = Vector3.new(math.cos(angle) * math.random(25, 40), -1, math.sin(angle) * math.random(25, 40))
	spirit.Position = root.Position + offset
	spirit.Parent = workspace
	
	local isAggressive = math.random(1, 2) == 2
	local speed = isAggressive and (math.random(40, 80) / 100) or 0
	
	local spiritData = {
		Part = spirit,
		IsAggressive = isAggressive,
		Speed = speed
	}
	table.insert(cursedSpirits, spiritData)
	
	task.delay(5, function()
		if spirit and spirit.Parent then
			local tween = TweenService:Create(spirit, TweenInfo.new(0.5), {Transparency = 1})
			tween:Play()
			tween.Completed:Connect(function() spirit:Destroy() end)
		end
	end)
end

local function playWhisper()
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. WHISPERS[math.random(1, #WHISPERS)]
	sound.Volume = 1
	sound.Parent = camera
	sound:Play()
	sound.Ended:Connect(function() sound:Destroy() end)
end

--============================================================
-- ARKA PLAN DÖNGÜLERİ (EVENTS)
--============================================================

local function startBackgroundEvents()
	if backgroundLoops then task.cancel(backgroundLoops) end
	backgroundLoops = task.spawn(function()
		local spiritTimer = 0
		while currentStyle == "Guts" or currentStyle == "Berserker" do
			task.wait(1)
			
			if not inDarkSky and math.random(1, 100) == 1 then
				triggerDarkSky()
			end
			
			spiritTimer += 1
			if spiritTimer >= 10 then
				spiritTimer = 0
				if math.random(1, 10) == 1 then
					spawnCursedSpirit()
					playWhisper()
				end
			end
		end
	end)
end

