--============================================================

local function startBackgroundEvents()
	if backgroundLoops then task.cancel(backgroundLoops) end
	backgroundLoops = task.spawn(function()
		local spiritTimer = 0
		while currentStyle == "Guts" or currentStyle == "Berserker" do
			task.wait(1)
			
			-- Eclipse İhtimali (%10 her saniye)
			if not inEclipse and math.random(1, 10) == 1 then
				triggerEclipse()
			end
			
			-- Ruhlar ve Fısıltılar (%10 her 10 saniye)
			spiritTimer += 1
			if spiritTimer >= 10 then
				spiritTimer = 0
				if math.random(1, 10) == 1 then
					spawnCursedSpirit()
					playWhisper()
				end
			end
		end
	end)
end

