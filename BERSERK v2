--============================================================

local function playAttack(animId)
	if not animator then return end
	if attackTrack then pcall(function() attackTrack:Stop(0.2); attackTrack:Destroy() end); attackTrack = nil end
	local animation = Instance.new("Animation")
	animation.AnimationId = animId
	animation.Name = "CustomAttack"
	local success, track = pcall(function() return animator:LoadAnimation(animation) end)
	animation:Destroy()
	if success and track then
		attackTrack = track
		attackTrack.Priority = Enum.AnimationPriority.Action4
		attackTrack.Looped = false
		attackTrack:Play(0.2, 1, 1)
	end
end

local function activateSmellThem()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= character then
			local hl = Instance.new("Highlight")
			hl.Name = "BerserkSmell"
			hl.FillColor = Color3.fromRGB(180, 0, 0)
			hl.OutlineColor = Color3.fromRGB(255, 0, 0)
			hl.FillTransparency = 1 
			hl.OutlineTransparency = 1
			hl.Parent = obj
			local tweenIn = TweenService:Create(hl, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {FillTransparency = 0.6, OutlineTransparency = 0})
			tweenIn:Play()
			task.delay(5, function()
				if hl and hl.Parent then
					local tweenOut = TweenService:Create(hl, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {FillTransparency = 1, OutlineTransparency = 1})
					tweenOut:Play()
					tweenOut.Completed:Connect(function() hl:Destroy() end)
				end
			end)
		end
	end
end

local function playIdle()
	if not animator or not currentStyle or not isIdle() then return end
	if idleTrack then pcall(function() idleTrack:Stop(0.2); idleTrack:Destroy() end); idleTrack = nil end

	local animIdToPlay = nil
	if currentStanceId then animIdToPlay = currentStanceId
	elseif currentStyle == "Guts" and humanoid.Health <= (humanoid.MaxHealth * 0.3) then animIdToPlay = GUTS_INJURED_IDLE
	else
		local list = IDLE_ANIMS[currentStyle]
		if list then
			local totalWeight = 0
			for _, data in ipairs(list) do totalWeight += data.Weight end
			local rnd = math.random(1, totalWeight)
			local counter = 0
			for _, data in ipairs(list) do
				counter += data.Weight
				if rnd <= counter then animIdToPlay = data.Id; break end
			end
		end
	end

	if not animIdToPlay then return end
	local animation = Instance.new("Animation")
	animation.AnimationId = animIdToPlay
	local success, track = pcall(function() return animator:LoadAnimation(animation) end)
	animation:Destroy()
	
	if success and track then
		idleTrack = track
		idleTrack.Priority = Enum.AnimationPriority.Action3
		idleTrack.Looped = not (currentStyle == "Guts" and not currentStanceId)
		idleConnection = idleTrack.Ended:Connect(function()
			if idleTrack == track and humanoid and humanoid.Health > 0 and isIdle() then
				task.wait(0.08)
				if isIdle() then playIdle() end
			end
		end)
		track:Play(0.2, 1, 1)
	end
end

local function createRun()
	if not animator or not currentStyle or not RUN_ENABLED[currentStyle] then return end
	if runTrack then pcall(function() runTrack:Stop(0.2); runTrack:Destroy() end) end
	local animation = Instance.new("Animation")
	animation.AnimationId = RUN_ANIM
	local success, track = pcall(function() return animator:LoadAnimation(animation) end)
	animation:Destroy()
	if success and track then
		runTrack = track
		runTrack.Priority = Enum.AnimationPriority.Action2
		runTrack.Looped = true
	end
end

