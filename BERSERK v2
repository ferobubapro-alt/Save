local function applyBerserkerDebuff()
	if isDebuffed then return end
	isDebuffed = true
	wasBerserker = false
	
	if humanoid then humanoid.WalkSpeed = DEBUFF_SPEED end
	
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "BerserkDebuffCC"
	cc.Saturation = -1
	cc.Contrast = 0.2
	cc.Parent = Lighting
	
	TweenService:Create(camera, TweenInfo.new(2), {FieldOfView = 50}):Play()
	
	task.delay(15, function()
		if cc and cc.Parent then
			local t = TweenService:Create(cc, TweenInfo.new(3), {Saturation = 0, Contrast = 0})
			t:Play()
			t.Completed:Connect(function() cc:Destroy() end)
		end
		TweenService:Create(camera, TweenInfo.new(3), {FieldOfView = 70}):Play()
		if humanoid and isDebuffed then humanoid.WalkSpeed = DEFAULT_SPEED end
		isDebuffed = false
	end)
end

