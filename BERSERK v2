local function triggerDarkSky()
	if inDarkSky then return end
	inDarkSky = true

	local oldSky = Lighting:FindFirstChildOfClass("Sky")
	if oldSky then
		oldSky.Parent = nil
	end

	local oldAmbient = Lighting.Ambient
	local oldOutdoor = Lighting.OutdoorAmbient
	local oldBrightness = Lighting.Brightness

	local sky = Instance.new("Sky")
	sky.Name = "TempDarkSky"

	sky.SkyboxBk = ECLIPSE_SKYBOX
	sky.SkyboxDn = ECLIPSE_SKYBOX
	sky.SkyboxFt = ECLIPSE_SKYBOX
	sky.SkyboxLf = ECLIPSE_SKYBOX
	sky.SkyboxRt = ECLIPSE_SKYBOX
	sky.SkyboxUp = ECLIPSE_SKYBOX

	sky.Parent = Lighting

	TweenService:Create(
		Lighting,
		TweenInfo.new(1),
		{
			Ambient = Color3.fromRGB(5, 0, 0),
			OutdoorAmbient = Color3.fromRGB(5, 0, 0),
			Brightness = 0.2
		}
	):Play()

	task.delay(5, function()
		if sky and sky.Parent then
			sky:Destroy()
		end

		if oldSky then
			oldSky.Parent = Lighting
		end

		TweenService:Create(
			Lighting,
			TweenInfo.new(2),
			{
				Ambient = oldAmbient,
				OutdoorAmbient = oldOutdoor,
				Brightness = oldBrightness
			}
		):Play()

		task.delay(2, function()
			inDarkSky = false
		end)
	end)
end

