local function endEclipse()
	inEclipse = false
	if eclipseMap then eclipseMap:Destroy(); eclipseMap = nil end
	local sky = Lighting:FindFirstChild("EclipseSky")
	if sky then sky:Destroy() end
	
	for _, m in ipairs(eclipseMonsters) do if m then m:Destroy() end end
	eclipseMonsters = {}
	
	if character and character:FindFirstChild("HumanoidRootPart") and preEclipseCFrame then
		character.HumanoidRootPart.CFrame = preEclipseCFrame
	end
end

local function triggerEclipse()
	if inEclipse or not character or not character:FindFirstChild("HumanoidRootPart") then return end
	inEclipse = true
	
	local root = character.HumanoidRootPart
	preEclipseCFrame = root.CFrame
	
	-- Eclipse Map Oluştur (Çok yüksekte)
	eclipseMap = Instance.new("Part")
	eclipseMap.Size = Vector3.new(1000, 20, 1000)
	eclipseMap.Position = Vector3.new(0, 50000, 0)
	eclipseMap.Anchored = true
	eclipseMap.Color = Color3.fromRGB(15, 0, 0)
	eclipseMap.Material = Enum.Material.Basalt
	eclipseMap.Parent = workspace
	
	-- Skybox
	local sky = Instance.new("Sky")
	sky.Name = "EclipseSky"
	sky.SkyboxBk = ECLIPSE_SKYBOX
	sky.SkyboxDn = ECLIPSE_SKYBOX
	sky.SkyboxFt = ECLIPSE_SKYBOX
	sky.SkyboxLf = ECLIPSE_SKYBOX
	sky.SkyboxRt = ECLIPSE_SKYBOX
	sky.SkyboxUp = ECLIPSE_SKYBOX
	sky.Parent = Lighting
	
	-- Işınla
	task.wait(0.1)
	root.CFrame = CFrame.new(0, 50015, 0)
	
	-- Yaratık Spawn Döngüsü
	task.spawn(function()
		local endTime = tick() + 60 -- Maks 60 saniye
		while inEclipse and tick() < endTime do
			if character and character:FindFirstChild("HumanoidRootPart") then
				local pPos = character.HumanoidRootPart.Position
				local dist = math.random(50, 200)
				local angle = math.random() * math.pi * 2
				local spawnPos = pPos + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
				
				-- Sadece sende gözükecek dummy yaratık
				local monster = Instance.new("Part")
				monster.Size = Vector3.new(3, 6, 3)
				monster.Color = Color3.fromRGB(5, 5, 5)
				monster.Material = Enum.Material.Neon
				monster.Position = Vector3.new(spawnPos.X, 50015, spawnPos.Z)
				monster.Anchored = true
				monster.CanCollide = false
				monster.Parent = workspace
				table.insert(eclipseMonsters, monster)
			end
			task.wait(2)
		end
		endEclipse()
	end)
end

