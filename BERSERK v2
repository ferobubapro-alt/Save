--============================================================
-- UPDATE (DÖNGÜ)
--============================================================

local function update()
	if not humanoid or humanoid.Health <= 0 then return end
	
	stopDefaultAnimations()

	-- Ruhların Yönlendirilmesi ve Çarpışma Kontrolü
	if character and character:FindFirstChild("HumanoidRootPart") then
		local pPos = character.HumanoidRootPart.Position
		for i = #cursedSpirits, 1, -1 do
			local sData = cursedSpirits[i]
			local s = sData.Part
			
			if s and s.Parent then
				local dist = (pPos - s.Position).Magnitude
				
				if dist < 3 then
					-- Oyuncuya Dokunduysa Sil
					s:Destroy()
					table.remove(cursedSpirits, i)
				else
					-- Saldırgan veya Gözlemci Hareketleri
					if sData.IsAggressive then
						local dir = (pPos - s.Position).Unit
						s.CFrame = s.CFrame + (dir * sData.Speed)
					else
						-- Sadece bakarak hafif süzülür
						s.CFrame = CFrame.new(s.Position, Vector3.new(pPos.X, s.Position.Y, pPos.Z))
					end
				end
			else
				table.remove(cursedSpirits, i)
			end
		end
	end

	local moving = humanoid.MoveDirection.Magnitude > 0.05
	local state = humanoid:GetState()
	local airborne = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown

	if not moving and not airborne then
		if runTrack and runTrack.IsPlaying then runTrack:Stop(0.2) end
		if not attackTrack or not attackTrack.IsPlaying then
			if not idleTrack or not idleTrack.IsPlaying then playIdle() end
		end
		return
	end

	if moving and not airborne then
		if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(0.2) end
		if attackTrack and attackTrack.IsPlaying then attackTrack:Stop(0.2) end
		if RUN_ENABLED[currentStyle] then
			if not runTrack then createRun() end
			if runTrack and not runTrack.IsPlaying then runTrack:Play(0.2, 1, 1) end
		end
		return
	end

	if airborne then
		if idleTrack and idleTrack.IsPlaying then idleTrack:Stop(0.2) end
		if runTrack and runTrack.IsPlaying then runTrack:Stop(0.2) end
		if attackTrack and attackTrack.IsPlaying then attackTrack:Stop(0.2) end
	end
end

