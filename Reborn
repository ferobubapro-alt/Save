local function CreateProSlider(parentContainer, name, min, max, default, unit, hasButton, btnText, callback)
    local RowFrame = Instance.new("Frame")
    RowFrame.Size = UDim2.new(1, 0, 0, 30)
    RowFrame.BackgroundTransparency = 1
    RowFrame.Parent = parentContainer

    local TitleLbl = Instance.new("TextLabel")
    TitleLbl.Size = UDim2.new(0, 80, 1, 0)
    TitleLbl.Position = UDim2.new(0, 5, 0, 0)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = name
    TitleLbl.Font = Enum.Font.GothamMedium
    TitleLbl.TextColor3 = Color3.fromRGB(230, 230, 230)
    TitleLbl.TextSize = 12
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
    TitleLbl.Parent = RowFrame

    local ValueLbl = Instance.new("TextLabel")
    ValueLbl.Size = UDim2.new(0, 50, 1, 0)
    ValueLbl.Position = UDim2.new(0, 75, 0, 0)
    ValueLbl.BackgroundTransparency = 1
    ValueLbl.Text = tostring(default) .. " " .. unit
    ValueLbl.Font = Enum.Font.Gotham
    ValueLbl.TextColor3 = Color3.fromRGB(180, 180, 190)
    ValueLbl.TextSize = 11
    ValueLbl.TextXAlignment = Enum.TextXAlignment.Left
    ValueLbl.Parent = RowFrame

    -- Slider'ın konum ve boyutu butona göre ayarlanır
    local sliderWidth = hasButton and 65 or 90
    local sliderX = hasButton and 140 or 150

    local SliderBG = Instance.new("TextButton")
    SliderBG.Size = UDim2.new(0, sliderWidth, 0, 6)
    SliderBG.Position = UDim2.new(0, sliderX, 0.5, -3)
    SliderBG.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
    SliderBG.Text = ""
    Instance.new("UICorner", SliderBG).CornerRadius = UDim.new(1, 0)
    SliderBG.Parent = RowFrame

    local SliderFill = Instance.new("Frame")
    local fillPct = (default - min) / (max - min)
    SliderFill.Size = UDim2.new(fillPct, 0, 1, 0)
    SliderFill.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
    Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(1, 0)
    SliderFill.Parent = SliderBG

    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.new(0, 12, 0, 12)
    Circle.Position = UDim2.new(1, -6, 0.5, -6)
    Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)
    Circle.Parent = SliderFill

    local dragging = false
    local function UpdateSlider(input)
        local pos = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
        SliderFill.Size = UDim2.new(pos, 0, 1, 0)
        local val = math.floor(min + ((max - min) * pos))
        ValueLbl.Text = tostring(val) .. " " .. unit
        pcall(function() callback(val) end)
    end

    SliderBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; UpdateSlider(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then UpdateSlider(input) end
    end)

    if hasButton then
        local ActionBtn = Instance.new("TextButton")
        ActionBtn.Size = UDim2.new(0, 55, 0, 20)
        ActionBtn.Position = UDim2.new(1, -55, 0.5, -10)
        ActionBtn.BackgroundColor3 = Color3.fromRGB(45, 40, 60)
        ActionBtn.Text = btnText
        ActionBtn.Font = Enum.Font.Gotham
        ActionBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
        ActionBtn.TextSize = 10
        Instance.new("UICorner", ActionBtn).CornerRadius = UDim.new(0, 4)
        ActionBtn.Parent = RowFrame
    end
end

